{
  "kind": "privesc-credentials-fixture",
  "note": "凭据面脆弱配置：automount/projected/legacy token、imagePullSecret、平台 token、云身份注解与 IMDS 可达。",
  "pods": [
    {
      "name": "trainer-0",
      "namespace": "train",
      "serviceAccount": "train-sa",
      "automountServiceAccountToken": true,
      "imagePullSecrets": [{"name": "regcred"}],
      "env": [
        {"name": "HF_TOKEN", "value": "MOCK-HF-TOKEN"},
        {"name": "WANDB_API_KEY", "value": "MOCK-WANDB-KEY"},
        {"name": "MLFLOW_TRACKING_TOKEN", "value": "MOCK-MLFLOW-TOKEN"},
        {"name": "AWS_ROLE_ARN", "value": "arn:aws:iam::123456789012:role/ml-admin"}
      ],
      "volumes": [
        {"name": "projected-token", "projected": {"sources": [
          {"serviceAccountToken": {"audience": "vault", "expirationSeconds": 86400, "path": "token"}}
        ]}}
      ]
    }
  ],
  "serviceaccounts": [
    {
      "name": "train-sa",
      "namespace": "train",
      "annotations": {
        "eks.amazonaws.com/role-arn": "arn:aws:iam::123456789012:role/ml-admin",
        "azure.workload.identity/client-id": "00000000-0000-0000-0000-000000000000",
        "iam.gke.io/gcp-service-account": "ml-admin@example.iam.gserviceaccount.com"
      }
    },
    {"name": "pipeline-runner", "namespace": "train", "automountServiceAccountToken": true}
  ],
  "secrets": [
    {"name": "pipeline-runner-token-abcde", "namespace": "train",
     "type": "kubernetes.io/service-account-token", "serviceAccount": "pipeline-runner"},
    {"name": "regcred", "namespace": "train", "type": "kubernetes.io/dockerconfigjson",
     "data": {"auth": "MOCK-BASE64"}},
    {"name": "hf-token", "namespace": "train", "type": "Opaque",
     "labels": {"ml-platform-token": "true"}, "keys": ["token"]},
    {"name": "mlflow-token", "namespace": "ops", "type": "Opaque",
     "labels": {"ml-platform-token": "true"}, "keys": ["tracking-token"]}
  ],
  "cloud": {
    "provider": "aws",
    "imds_reachable": true,
    "imds_v1": true,
    "irsa_trust": "arn:aws:iam::123456789012:role/ml-admin"
  }
}
