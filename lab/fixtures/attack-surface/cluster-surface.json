{
 "cluster": {
  "name": "surface-lab",
  "provider": "eks",
  "version": "1.28.3"
 },
 "namespaces": [
  "default",
  "train",
  "infer",
  "ray-system",
  "kube-system"
 ],
 "services": [
  {
   "name": "ray-dashboard",
   "namespace": "ray-system",
   "type": "LoadBalancer",
   "ports": [
    {
     "name": "dashboard",
     "port": 8265
    }
   ]
  },
  {
   "name": "sglang-server",
   "namespace": "infer",
   "type": "NodePort",
   "ports": [
    {
     "name": "http",
     "port": 30000,
     "nodePort": 31000
    }
   ]
  },
  {
   "name": "kubernetes",
   "namespace": "default",
   "type": "ClusterIP",
   "ports": [
    {
     "name": "https",
     "port": 443
    }
   ]
  }
 ],
 "pods": [
  {
   "name": "gpu-trainer-0",
   "namespace": "train",
   "serviceAccount": "trainer",
   "hostPID": true,
   "hostIPC": true,
   "volumes": [
    {
     "name": "sock",
     "hostPath": {
      "path": "/var/run/docker.sock"
     }
    },
    {
     "name": "logs",
     "hostPath": {
      "path": "/var/log"
     }
    },
    {
     "name": "modules",
     "hostPath": {
      "path": "/lib/modules"
     }
    }
   ],
   "containers": [
    {
     "name": "trainer",
     "image": "pytorch/pytorch:2.4",
     "securityContext": {
      "privileged": true,
      "capabilities": {
       "add": [
        "SYS_ADMIN",
        "SYS_MODULE",
        "SYS_PTRACE"
       ]
      },
      "seccompProfile": {
       "type": "Unconfined"
      }
     },
     "env": [
      {
       "name": "AWS_ACCESS_KEY_ID",
       "value": "AKIAIOSFODNN7EXAMPLE"
      },
      {
       "name": "AWS_SECRET_ACCESS_KEY",
       "value": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
      },
      {
       "name": "HF_TOKEN",
       "value": "hf_abcdefghijklmnopqrstuvwxyz0123456789"
      }
     ]
    }
   ]
  },
  {
   "name": "ray-head-0",
   "namespace": "ray-system",
   "serviceAccount": "ray-operator",
   "hostNetwork": true,
   "volumes": [
    {
     "name": "kube",
     "hostPath": {
      "path": "/etc/kubernetes"
     }
    }
   ],
   "containers": [
    {
     "name": "ray",
     "image": "rayproject/ray:2.40.0",
     "securityContext": {
      "runAsUser": 0
     }
    }
   ]
  },
  {
   "name": "sglang-server-0",
   "namespace": "infer",
   "serviceAccount": "sglang-sa",
   "volumes": [
    {
     "name": "dev",
     "hostPath": {
      "path": "/dev"
     }
    },
    {
     "name": "proc",
     "hostPath": {
      "path": "/proc"
     }
    }
   ],
   "containers": [
    {
     "name": "sglang",
     "image": "lmsysorg/sglang:v0.5.22",
     "securityContext": {
      "privileged": true
     }
    }
   ]
  },
  {
   "name": "node-agent",
   "namespace": "kube-system",
   "serviceAccount": "node-agent",
   "volumes": [
    {
     "name": "root",
     "hostPath": {
      "path": "/"
     }
    }
   ],
   "containers": [
    {
     "name": "agent",
     "image": "registry.local/node-agent:1",
     "securityContext": {
      "capabilities": {
       "add": [
        "DAC_READ_SEARCH"
       ]
      }
     }
    }
   ]
  },
  {
   "name": "clean-app-0",
   "namespace": "default",
   "serviceAccount": "default",
   "automountServiceAccountToken": false,
   "containers": [
    {
     "name": "web",
     "image": "nginx:1.27",
     "securityContext": {
      "runAsNonRoot": true,
      "seccompProfile": {
       "type": "RuntimeDefault"
      }
     }
    }
   ]
  }
 ],
 "cani": [
  {
   "subject": "system:serviceaccount:train:trainer",
   "allowed": [
    "*"
   ]
  },
  {
   "subject": "system:serviceaccount:ray-system:ray-operator",
   "allowed": [
    "create pods",
    "get pods",
    "list pods",
    "list secrets",
    "pods/exec"
   ]
  },
  {
   "subject": "system:serviceaccount:infer:sglang-sa",
   "allowed": [
    "get secrets",
    "list configmaps",
    "create pods",
    "create pods/exec"
   ]
  },
  {
   "subject": "system:serviceaccount:kube-system:node-agent",
   "allowed": [
    "get nodes/proxy",
    "create tokenreviews",
    "create selfsubjectaccessreviews",
    "get secrets"
   ]
  },
  {
   "subject": "user:intern",
   "allowed": [
    "get pods",
    "list pods",
    "impersonate users",
    "create rolebindings",
    "get secrets"
   ]
  }
 ],
 "clusterroles": [
  {
   "name": "app-wildcard",
   "rules": [
    {
     "verbs": [
      "*"
     ],
     "resources": [
      "*"
     ]
    }
   ]
  },
  {
   "name": "secret-reader",
   "rules": [
    {
     "verbs": [
      "get",
      "list"
     ],
     "resources": [
      "secrets"
     ]
    }
   ]
  },
  {
   "name": "backdoor-admin",
   "rules": [
    {
     "verbs": [
      "*"
     ],
     "resources": [
      "*"
     ]
    }
   ]
  }
 ],
 "clusterrolebindings": [
  {
   "name": "app-wildcard-binding",
   "role": "app-wildcard",
   "subjects": [
    "system:serviceaccount:train:trainer"
   ]
  },
  {
   "name": "intern-admin",
   "role": "cluster-admin",
   "subjects": [
    "user:intern"
   ]
  },
  {
   "name": "backdoor-admin-binding",
   "role": "backdoor-admin",
   "subjects": [
    "user:backdoor"
   ]
  }
 ],
 "secrets": [
