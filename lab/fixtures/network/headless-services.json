      "metadata": {"name": "remote-model-svc", "namespace": "train"},
      "spec": {
        "ports": [{"name": "http", "port": 8000}],
        "type": "ClusterSetIP"
      }
    },
    {
      "apiVersion": "submariner.io/v1",
      "kind": "Endpoint",
      "metadata": {"name": "cluster-b-gw", "namespace": "submariner-operator"},
      "spec": {
        "cluster_id": "cluster-b",
        "private_ip": "10.200.0.9",
        "public_ip": "203.0.113.20",
        "subnets": ["10.200.0.0/16"]
      }
    }
  ]
