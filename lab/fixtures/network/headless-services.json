{
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {"name": "ray-gcs", "namespace": "train", "labels": {"app": "ray-gcs"}},
      "spec": {
        "clusterIP": "None",
        "selector": {"app": "ray-head"},
        "ports": [
          {"name": "gcs", "port": 6379},
          {"name": "dashboard", "port": 8265},
          {"name": "client", "port": 10001}
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {"name": "llm-train-rdzv", "namespace": "train"},
      "spec": {
        "clusterIP": "None",
        "selector": {"train-lead": "true"},
        "ports": [{"name": "rdzv", "port": 29500}]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {"name": "ml-dataset-svc", "namespace": "train"},
      "spec": {
        "clusterIP": "None",
        "selector": {"app": "dataset-server"},
        "ports": [{"name": "http", "port": 8080}]
      }
    },
    {
      "apiVersion": "multicluster.x-k8s.io/v1alpha1",
