{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicyList",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {"name": "default-deny-egress-api", "namespace": "infer"},
      "spec": {
        "podSelector": {"matchLabels": {"app": "api-gw"}},
        "policyTypes": ["Egress"],
        "egress": [
          {
            "to": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}}}],
            "ports": [{"protocol": "UDP", "port": 53}]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {"name": "allow-train-ingress", "namespace": "train"},
      "spec": {
        "podSelector": {"matchLabels": {"app": "rl-train"}},
        "policyTypes": ["Ingress"],
        "ingress": [
          {"from": [{"namespaceSelector": {"matchLabels": {"team": "ml"}}}], "ports": [{"port": 8000}]}
        ]
      }
    }
  ]
}
