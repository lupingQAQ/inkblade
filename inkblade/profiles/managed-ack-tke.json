{
  "schema": "inkblade-profile-v1",
  "name": "managed-ack-tke",
  "description": "Managed ACK/TKE control plane: no direct etcd or node BMC access, cloud metadata reachable, Istio ambient mesh and confidential-container runtime class enabled.",
  "platform": "managed-kubernetes",
  "complete": true,
  "inherit": ["_k8s-core", "_inference"],
  "exclude": ["StatefulSet/etcd", "CSIDriver/ceph.csi", "NetworkPolicy/default-deny"],
  "components": {
    "orchestrator": "ack-tke",
    "scheduler": "managed",
    "gpu_sharing": "none",
    "inference": ["vllm"],
    "hardware": [],
    "cloud_metadata": "reachable",
    "service_mesh": "istio-ambient"
  },
  "surfaces": [
    {"type": "k8s-object", "selector": "Deployment/istiod"},
    {"type": "k8s-object", "selector": "DaemonSet/ztunnel"},
    {"type": "k8s-object", "selector": "DaemonSet/istio-cni"},
    {"type": "k8s-object", "selector": "RuntimeClass/kata-cc"},
    {"type": "k8s-object", "selector": "Deployment/litellm"},
    {"type": "k8s-object", "selector": "Deployment/open-webui"},
    {"type": "k8s-object", "selector": "Deployment/mlflow"},
    {"type": "k8s-object", "selector": "Deployment/dify"},
    {"type": "http-endpoint", "selector": "/metadata"},
    {"type": "http-endpoint", "selector": "/healthz/ready"},
    {"type": "http-endpoint", "selector": "/key/info"},
    {"type": "http-endpoint", "selector": "/config"},
    {"type": "http-endpoint", "selector": "/admin/console"},
    {"type": "http-endpoint", "selector": "/api"},
    {"type": "config-file", "selector": "istio/ambient.yaml"},
    {"type": "config-file", "selector": "kata/config.toml"},
    {"type": "config-file", "selector": "litellm/config.yaml"},
    {"type": "config-file", "selector": "open-webui/config.yaml"},
    {"type": "config-file", "selector": "mlflow/config.yaml"},
    {"type": "config-file", "selector": "dify/config.yaml"},
    {"type": "config-file", "selector": "cloud/ack.json"},
    {"type": "runtime-agent", "selector": "runtime-agent/ztunnel"},
    {"type": "runtime-agent", "selector": "runtime-agent/istio-cni"},
    {"type": "runtime-agent", "selector": "runtime-agent/kata"}
  ]
}
