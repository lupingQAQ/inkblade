{
  "id": "fabric-exhaustion-chain",
  "title": {
    "zh": "fabric 资源耗尽（端口/I-O/配额/队列）→ 集群级 DoS",
    "en": "Fabric resource exhaustion (ports/IO/quota/queue) → cluster-level DoS"
  },
  "category": "网络利用链",
  "requires": [
    "nccl-port-exhaustion",
    "nccl-straggler-injection",
    "checkpoint-io-storm",
    "api-server-flood-surface",
    "kv-oom-bomb",
    "gang-scheduler-abuse",
    "roce-pfc-storm",
    "driver-reset-trigger"
  ],
  "preconditions": [
    {"expr": "findings('nccl-port-exhaustion').any(severity == 'high')"}
