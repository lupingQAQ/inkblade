{
  "schema": "inkblade-probe-template-v1",
  "key": "vllm-surface-fuzz",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "vLLM 五类接口面差分 fuzz",
      "en": "vLLM Five-Surface Differential Fuzz"
    },
    "series": "横向利用",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.surface.ok == true",
      "sev": "high",
      "title": "vLLM {surface} 面鉴权差分：{row[",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/DEPTH-REVIEW.md §1；corpus/depth/vllm_patch_matrix.json",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "vllm-surface-fuzz-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
