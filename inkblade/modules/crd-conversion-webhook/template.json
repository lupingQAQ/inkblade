{
  "schema": "inkblade-probe-template-v1",
  "key": "crd-conversion-webhook",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "CRD conversion Webhook",
      "en": "CRD conversion webhook"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  },
  "computed": {
    "risky": "filter(steps.snapshot.json.customresourcedefinitions, it.conversion.strategy == 'Webhook' and not it.conversion.webhook.clientConfig.caBundle)"
  },
  "findings": [
    {
      "id": "crd",
      "for_each": "computed.risky",
      "as": "crd",
      "sev": "high",
      "title": "CRD conversion webhook 缺 CA：{{crd.name}}",
      "detail": "conversion webhook 未配置 caBundle/不安全；可拦截/篡改所有 CR 版本转换，向 operator 注入恶意对象。",
      "evidence": "crd={{crd.name}} clientConfig={{str(crd.conversion.webhook.clientConfig)}}",
      "mapping": "提权矩阵 rbac-crd-conversion-webhook；K8s CRD versioning",
      "fix": "为 conversion webhook 配置受信 CA；限制 CRD 写权限；监控 conversion webhook 变更"
    }
  ],
  "artifacts": [
    {
      "name": "crd-conversion-webhook-detection.json",
      "kind": "json",
      "fields": {
        "risky": "map(computed.risky, it.name)"
      }
    }
  ]
}
