{
  "schema": "inkblade-probe-template-v1",
  "key": "experiment-tracker-exposure",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "实验追踪器未授权暴露",
      "en": "Experiment tracker exposure"
    },
    "series": "窃取与数据泄露",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.surface.ok == true",
      "sev": "high",
      "title": "实验追踪器未授权：跨租户 run/指标可读 + MLflow 无鉴权 + W&B 凭据可见（尾4位）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/PRETRAIN-SFT-RL-COVERAGE.md 第 5 节：实验追踪器暴露面；MLflow/W&B/TensorBoard 默认无鉴权部署姿势",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.surface.ok == true",
      "sev": "info",
      "title": "实验追踪器被拒绝或已加固（401 / 鉴权开启 / 无跨租户数据）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/PRETRAIN-SFT-RL-COVERAGE.md 第 5 节：实验追踪器暴露面；MLflow/W&B/TensorBoard 默认无鉴权部署姿势",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "experiment-tracker-exposure-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
