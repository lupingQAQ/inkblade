{
  "schema": "inkblade-probe-template-v1",
  "key": "openjev-clef-release-module",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "OpenJEV clef 发布模块加载",
      "en": "OpenJEV clef Release-Module Load"
    },
    "series": "窃取与数据泄露",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'model-file', 'selector': 'model'}",
      "{'type': 'config-file', 'selector': 'openjev'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "observed",
      "when": "steps.surface.ok == true",
      "sev": "info",
      "title": "OpenJEV clef 发布模块加载：部署面已观测",
      "detail": "Template executed and the declared surface responded; no exploitable condition asserted.",
      "evidence": "steps"
    }
  ],
  "artifacts": [
    {
      "name": "openjev-clef-release-module-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
