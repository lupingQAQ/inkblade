{
  "schema": "inkblade-probe-template-v1",
  "key": "msswift-eval-escape",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "ms-swift ranks 表达式逃逸",
      "en": "ms-swift ranks Expression Sandbox Escape"
    },
    "series": "核心代码",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'http-endpoint', 'selector': '/webui'}",
      "{'type': 'config-file', 'selector': 'ms-swift'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.surface.ok == true",
      "sev": "high",
      "title": "{KEY}: attacker-controlled parameter",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/WEAPON-READINESS.md#msswift-eval-escape",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "msswift-eval-escape-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
