{
  "schema": "inkblade-probe-template-v1",
  "key": "confidential-containers-audit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "机密容器运行时与证明面审计",
      "en": "Confidential-container runtime and attestation surface"
    },
    "series": "侦察",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'k8s-object', 'selector': 'RuntimeClass/kata-cc'}",
      "{'type': 'runtime-agent', 'selector': 'kata'}",
      "{'type': 'config-file', 'selector': 'kata'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {},
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "host",
      "op": "fs",
      "action": "stat",
      "path": "/",
      "save": "host",
      "allow_failure": true
    }
  ],
  "checks": [
    {
      "id": "host-readable",
      "when": "steps.host.exists == true",
      "message": "probe filesystem is not readable"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "true",
      "sev": "medium",
      "title": "机密容器 RuntimeClass 已部署但缺少证明/TEE 配置证据",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md 机密容器与 TEE 面的生产可测性",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "true",
      "sev": "high",
      "title": "机密容器启用调试/放宽参数，削弱 TEE 边界",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md 机密容器与 TEE 面的生产可测性",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "true",
      "sev": "high",
      "title": "机密容器运行时显式关闭证明",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md 机密容器与 TEE 面的生产可测性",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "confidential-containers-audit-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
