{
  "schema": "inkblade-probe-template-v1",
  "key": "sglang-omni-profiler-write",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "sglang-omni 目录写",
      "en": "sglang-omni Profiler Directory Write"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/update_weights_from_disk",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000,
      "body": {
        "marker": "{{ctx.marker}}",
        "benign": true
      },
      "write": true
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/design.md 第 1–5 节：sglang-omni 管理面+profiler 目录写",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "sglang-omni：管理面 fail-open + profiler 事件目录任意写原语",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/design.md 第 1–5 节：sglang-omni 管理面+profiler 目录写",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "medium",
      "title": "sglang-omni：管理面 fail-open（写原语前置成立，未执行写入）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/design.md 第 1–5 节：sglang-omni 管理面+profiler 目录写",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "sglang-omni-profiler-write-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "write-surface demo; requires backup receipt"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  }
}
