{
  "schema": "inkblade-probe-template-v1",
  "key": "aigateway-quota-bypass",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 网关配额绕过（X-Forwarded-For 轮换）",
      "en": "AI Gateway Quota Bypass via X-Forwarded-For Rotation"
    },
    "series": "横向利用",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe2",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/quota",
      "headers": {},
      "save": "probe2",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "配额绕过：轮换 X-Forwarded-For 后 {count} 次请求 0 限流（桶数 {len(buckets_after)}）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/AI-GATEWAY.md 第 7 节：配额键与信任边界",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "aigateway-quota-bypass-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
