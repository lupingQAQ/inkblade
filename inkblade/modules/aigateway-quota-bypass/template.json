{
  "schema": "inkblade-probe-template-v1",
  "key": "aigateway-quota-bypass",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 网关配额绕过（X-Forwarded-For 轮换）",
      "en": "AI Gateway Quota Bypass via X-Forwarded-For Rotation"
    },
    "series": "横向利用",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab-only probe"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 24
  },
  "computed": {
    "not_enforced": "steps.after.status == 200 and steps.after.json.enforced == false",
    "by_ip": "steps.after.json.bucket_by == 'x-forwarded-for'",
    "buckets": "count(steps.after.json.buckets)"
  },
  "steps": [
    {
      "id": "before",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/quota",
      "headers": {
        "Authorization": "Bearer MOCK-tenant-a-key-a1b2",
        "X-Forwarded-For": "10.9.9.1"
      },
      "save": "before",
      "allow_failure": true
    },
    {
      "id": "chat",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "body": {
        "model": "gpt-4o",
        "messages": [
          {
            "role": "user",
            "content": "INKBLADE-BENIGN probe"
          }
        ],
        "max_tokens": 8
      },
      "headers": {
        "Authorization": "Bearer MOCK-tenant-a-key-a1b2",
        "X-Forwarded-For": "10.9.9.2"
      },
      "save": "chat",
      "allow_failure": true
    },
    {
      "id": "after",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/quota",
      "headers": {
        "Authorization": "Bearer MOCK-tenant-a-key-a1b2",
        "X-Forwarded-For": "10.9.9.3"
      },
      "save": "after",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "bypass",
      "when": "computed.not_enforced and computed.by_ip",
      "sev": "high",
      "title": "配额按 X-Forwarded-For 分桶且未强制：轮换头即重置配额",
      "detail": "enforced={{steps.after.json.enforced}} bucket_by={{steps.after.json.bucket_by}} buckets={{computed.buckets}} limit={{steps.after.json.limit}}",
      "evidence": "{{steps.after.sha256}}",
      "mapping": "OWASP LLM10 无界消耗",
      "fix": "配额按 API key/主体分桶并强制；忽略客户端 X-Forwarded-For"
    },
    {
      "id": "clean",
      "when": "not (computed.not_enforced and computed.by_ip)",
      "sev": "info",
      "title": "配额按主体强制（X-Forwarded-For 被忽略）",
      "detail": "enforced={{steps.after.json.enforced}} bucket_by={{steps.after.json.bucket_by}}"
    }
  ],
  "artifacts": [
    {
      "name": "aigateway-quota-bypass.json",
      "kind": "json",
      "fields": {
        "enforced": "steps.after.json.enforced",
        "bucket_by": "steps.after.json.bucket_by",
        "buckets": "computed.buckets"
      }
    }
  ]
}
