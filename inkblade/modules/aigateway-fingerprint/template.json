{
  "schema": "inkblade-probe-template-v1",
  "key": "aigateway-fingerprint",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 网关指纹与未鉴权面",
      "en": "AI Gateway Fingerprint and Unauthenticated Surface"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/models",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe2",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/key/info",
      "headers": {},
      "save": "probe2",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe3",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/config",
      "headers": {},
      "save": "probe3",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe4",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/admin/console",
      "headers": {},
      "save": "probe4",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "observed",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "AI 网关指纹与未鉴权面：部署面已观测",
      "detail": "Template executed and the declared surface responded; no exploitable condition asserted.",
      "evidence": "steps"
    }
  ],
  "artifacts": [
    {
      "name": "aigateway-fingerprint-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
