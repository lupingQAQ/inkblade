{
  "schema": "inkblade-probe-template-v1",
  "key": "aigateway-fingerprint",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 网关指纹与未鉴权面",
      "en": "AI Gateway Fingerprint and Unauthenticated Surface"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab-only probe"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 24
  },
  "computed": {
    "open_admin": "steps.console.status == 200 and steps.console.json.console == true",
    "global_keys": "steps.keyinfo.status == 200 and steps.keyinfo.json.scope == 'global'",
    "open_chat": "steps.health.status == 200 and steps.models.status == 200"
  },
  "steps": [
    {
      "id": "health",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/health",
      "save": "health",
      "allow_failure": true
    },
    {
      "id": "models",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/models",
      "save": "models",
      "allow_failure": true
    },
    {
      "id": "keyinfo",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/key/info",
      "save": "keyinfo",
      "allow_failure": true
    },
    {
      "id": "config",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/config",
      "save": "config",
      "allow_failure": true
    },
    {
      "id": "console",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/admin/console",
      "save": "console",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "open",
      "when": "computed.open_chat",
      "sev": "high",
      "title": "AI 网关管理/推理面未鉴权暴露",
      "detail": "health={{steps.health.status}} models={{steps.models.status}} key_scope={{steps.keyinfo.json.scope}} console={{steps.console.status}}",
      "evidence": "{{steps.models.sha256}}",
      "mapping": "OWASP LLM06 过度暴露",
      "fix": "管理面与模型清单统一鉴权；默认关闭 /admin/console"
    },
    {
      "id": "master",
      "when": "computed.global_keys",
      "sev": "high",
      "title": "默认 master key 可枚举全局 key",
      "detail": "subject={{steps.keyinfo.json.subject}} visible={{str(steps.keyinfo.json.visible_tenants)}}",
      "fix": "移除默认 master key；key/info 仅返回调用者自身作用域"
    },
    {
      "id": "info",
      "when": "not computed.open_chat",
      "sev": "info",
      "title": "AI 网关鉴权基线正常"
    }
  ],
  "artifacts": [
    {
      "name": "aigateway-fingerprint.json",
      "kind": "json",
      "fields": {
        "health": "steps.health.status",
        "models": "steps.models.status",
        "key_scope": "steps.keyinfo.json.scope",
        "console": "steps.console.status",
        "gateway": "steps.config.json.gateway"
      }
    }
  ]
}
