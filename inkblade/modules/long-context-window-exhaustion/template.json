{
  "schema": "inkblade-probe-template-v1",
  "key": "long-context-window-exhaustion",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "长上下文窗口耗尽",
      "en": "Long-context window exhaustion"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "computed": {
    "over": "steps.chat.json.usage.prefill_tokens > steps.chat.json.context_window",
    "accepted": "steps.chat.status == 200",
    "queue_before": "steps.before.json.queue_depth",
    "queue_after": "steps.after.json.queue_depth",
    "queue_grew": "steps.after.json.queue_depth > steps.before.json.queue_depth"
  },
  "steps": [
    {
      "id": "before",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "save": "before",
      "allow_failure": true
    },
    {
      "id": "chat",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "model": "longctx-mock",
        "max_tokens": 8,
        "prompt_tokens": 200000,
        "messages": [
          {
            "role": "user",
            "content": "INKBLADE-BENIGN exhaustion probe"
          }
        ]
      },
      "save": "chat",
      "allow_failure": true
    },
    {
      "id": "after",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "save": "after",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "exhaust",
      "when": "computed.accepted and (computed.over or computed.queue_grew)",
      "sev": "high",
      "title": "超窗请求进入队列：prefill 资源被长上下文耗尽",
      "detail": "queue_before={{computed.queue_before}} queue_after={{computed.queue_after}} over={{computed.over}}",
      "evidence": "{{steps.chat.sha256}}",
      "mapping": "long-context-window-exhaustion",
      "fix": "超窗 400；队列按租户配额与 prompt 长度加权"
    },
    {
      "id": "clean",
      "when": "not (computed.accepted and (computed.over or computed.queue_grew))",
      "sev": "info",
      "title": "超窗请求被拒绝/未放大队列",
      "detail": "status={{steps.chat.status}} queue={{computed.queue_after}}"
    }
  ],
  "artifacts": [
    {
      "name": "long-context-window-exhaustion.json",
      "kind": "json",
      "fields": {
        "over": "computed.over",
        "queue_before": "computed.queue_before",
        "queue_after": "computed.queue_after"
      }
    }
  ]
}
