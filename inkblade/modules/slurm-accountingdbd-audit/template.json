{
  "schema": "inkblade-probe-template-v1",
  "key": "slurm-accountingdbd-audit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "SlurmDBD 记账库配置审计",
      "en": "SlurmDBD accounting database configuration audit"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'config-file', 'selector': 'slurm/slurmdbd.conf'}",
      "{'type': 'runtime-agent', 'selector': 'runtime-agent/slurmdbd'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "slurmdbd 未配置记账存储",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD slurmdbd.conf(5) / accounting_storage；docs/SLURM-HPC-COVERAGE.md 记账面",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "slurmdbd.conf 明文保存数据库口令",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD slurmdbd.conf(5) / accounting_storage；docs/SLURM-HPC-COVERAGE.md 记账面",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "slurmdbd 绑定到所有地址",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD slurmdbd.conf(5) / accounting_storage；docs/SLURM-HPC-COVERAGE.md 记账面",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "slurmdbd 以 root 运行",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD slurmdbd.conf(5) / accounting_storage；docs/SLURM-HPC-COVERAGE.md 记账面",
      "fix": ""
    },
    {
      "id": "f5",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "PrivateData 未限制记账可见性",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD slurmdbd.conf(5) / accounting_storage；docs/SLURM-HPC-COVERAGE.md 记账面",
      "fix": ""
    },
    {
      "id": "f6",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "未配置 StorageBackupHost",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD slurmdbd.conf(5) / accounting_storage；docs/SLURM-HPC-COVERAGE.md 记账面",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "slurm-accountingdbd-audit-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
