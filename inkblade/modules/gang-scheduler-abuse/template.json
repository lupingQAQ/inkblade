{
  "schema": "inkblade-probe-template-v1",
  "key": "gang-scheduler-abuse",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "gang/EPP 调度滥用（占位 job 拖垮队列）",
      "en": "Gang scheduler abuse via placeholder jobs"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/sched/gang",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "占位 gang 作业拖垮调度队列（后续训练作业全部阻塞）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/FABRIC-ATTACK-SURFACE.md §2.9；语料 meta-prometheus（64/72 切片与备件调度）/ gateway-api-inference-extension（EPP）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "gang 配额/鉴权生效或队列未阻塞（滥用未成立）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/FABRIC-ATTACK-SURFACE.md §2.9；语料 meta-prometheus（64/72 切片与备件调度）/ gateway-api-inference-extension（EPP）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "gang-scheduler-abuse-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
