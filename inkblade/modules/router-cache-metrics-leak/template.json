{
  "schema": "inkblade-probe-template-v1",
  "key": "router-cache-metrics-leak",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "路由器缓存指标泄露",
      "en": "Router cache metrics leak"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "benign cache-lab markers only"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "vars": {
    "victim_tenant": "tenant-b"
  },
  "computed": {
    "status_ok": "steps.metrics.status == 200",
    "victim_visible": "steps.metrics.json.per_tenant.tenant-b != null",
    "scope": "steps.metrics.json.aggregated.scope"
  },
  "steps": [
    {
      "id": "metrics",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/router/metrics",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "metrics",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "leak",
      "when": "computed.status_ok and computed.victim_visible",
      "sev": "high",
      "title": "路由/缓存指标跨租户泄漏：tenant-b 统计可见",
      "detail": "route=/router/metrics scope={{computed.scope}} visible_tenants={{steps.metrics.json.aggregated.tenants_visible}} victim_requests={{steps.metrics.json.per_tenant.tenant-b.requests}}",
      "evidence": "{{steps.metrics.sha256}}",
      "mapping": "router-cache-metrics-leak",
      "fix": "指标按调用主体做租户过滤；管理面单独鉴权"
    },
    {
      "id": "clean",
      "when": "computed.status_ok and not computed.victim_visible",
      "sev": "info",
      "title": "路由指标按租户过滤（未见 tenant-b 统计）",
      "detail": "scope={{computed.scope}}"
    }
  ],
  "artifacts": [
    {
      "name": "router-cache-metrics-leak.json",
      "kind": "json",
      "fields": {
        "route": "'/router/metrics'",
        "victim_visible": "computed.victim_visible",
        "scope": "computed.scope",
        "tenants_visible": "steps.metrics.json.aggregated.tenants_visible"
      }
    }
  ]
}
