{
  "schema": "inkblade-probe-template-v1",
  "key": "kv-cache-integrity-poison",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "KV cache 完整性污染",
      "en": "KV cache integrity poisoning"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/kv/transfer",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "KV cache 未鉴权写入并读回（跨租户完整性污染）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/LONG-CONTEXT.md 第 2 节：PD 分离 KV 通道与 KV cache 生命周期；spec 5.2 + 6.2 KV 通道链",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "KV 通道写面被拒绝或读回不一致（完整性污染未成立）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/LONG-CONTEXT.md 第 2 节：PD 分离 KV 通道与 KV cache 生命周期；spec 5.2 + 6.2 KV 通道链",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "PD KV 通道未鉴权可读（KV cache 完整性面暴露）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/LONG-CONTEXT.md 第 2 节：PD 分离 KV 通道与 KV cache 生命周期；spec 5.2 + 6.2 KV 通道链",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "KV 通道读面被拒绝（需管理密钥）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/LONG-CONTEXT.md 第 2 节：PD 分离 KV 通道与 KV cache 生命周期；spec 5.2 + 6.2 KV 通道链",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "kv-cache-integrity-poison-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "write-surface demo; requires backup receipt"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  }
}
