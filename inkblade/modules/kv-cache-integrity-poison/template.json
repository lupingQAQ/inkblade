{
  "schema": "inkblade-probe-template-v1",
  "key": "kv-cache-integrity-poison",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "KV cache 完整性污染",
      "en": "KV cache integrity poisoning"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  },
  "computed": {
    "found": "steps.read.status == 200 and steps.read.json.found == true",
    "marker": "contains(str(steps.read.json.value), 'INKBLADE')",
    "readback": "steps.readback.status == 200 and steps.readback.json.found == true"
  },
  "steps": [
    {
      "id": "read",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/kv/transfer",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "op": "read",
        "block_id": "tenant-b/ctx/seed-001"
      },
      "save": "read",
      "allow_failure": true
    },
    {
      "id": "write",
      "op": "http",
      "method": "POST",
      "write": true,
      "when": "params.mode == 'backup-write'",
      "url": "{{input.target}}/kv/transfer",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "op": "write",
        "block_id": "poison-{{ctx.marker}}",
        "value": "INKBLADE-BENIGN-POISON {{ctx.marker}}"
      },
      "save": "write",
      "allow_failure": true
    },
    {
      "id": "readback",
      "op": "http",
      "method": "POST",
      "when": "params.mode == 'backup-write'",
      "url": "{{input.target}}/kv/transfer",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "op": "read",
        "block_id": "poison-{{ctx.marker}}"
      },
      "save": "readback",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "cross",
      "when": "computed.found",
      "sev": "high",
      "title": "KV 块跨租户可读（block 命名空间未校验）",
      "detail": "block={{steps.read.json.block_id}} found={{steps.read.json.found}} layer={{steps.read.json.layer}}",
      "evidence": "{{steps.read.sha256}}",
      "mapping": "kv-cache-integrity-poison",
      "fix": "block id 绑定租户；读取前校验 namespace"
    },
    {
      "id": "poison",
      "when": "params.mode == 'backup-write' and computed.readback and steps.write.ok",
      "sev": "high",
      "title": "KV 块写入持久化（可注入跨请求缓存内容）",
      "detail": "block=poison-{{ctx.marker}} readback_found={{computed.readback}}",
      "evidence": "{{steps.readback.sha256}}",
      "mapping": "kv-cache-integrity-poison",
      "fix": "KV 写入仅同租户；内容签名/哈希校验"
    }
  ],
  "artifacts": [
    {
      "name": "kv-cache-integrity-poison.json",
      "kind": "json",
      "fields": {
        "found": "computed.found",
        "readback": "computed.readback",
        "mode": "params.mode"
      }
    }
  ]
}
