{
  "schema": "inkblade-probe-template-v1",
  "key": "remote-kv-pool-isolation",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "远程 KV 池命名空间绕过",
      "en": "Remote KV pool namespace bypass"
    },
    "series": "横向利用",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.surface.ok == true",
      "sev": "high",
      "title": "远程 KV 池命名空间绕过：{tenant} 直接读回 {block_tenant} 的 KV 块",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CACHE-SECURITY.md 第 5 节：远程 KV 池（Mooncake/LMCache 命名空间）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.surface.ok == true",
      "sev": "info",
      "title": "远程 KV 池块读按租户命名空间隔离（越权 403 或块不可见）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CACHE-SECURITY.md 第 5 节：远程 KV 池（Mooncake/LMCache 命名空间）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "remote-kv-pool-isolation-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
