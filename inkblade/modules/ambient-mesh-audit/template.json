{
  "schema": "inkblade-probe-template-v1",
  "key": "ambient-mesh-audit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "Ambient Mesh（ztunnel）面审计",
      "en": "Ambient mesh (ztunnel) surface audit"
    },
    "series": "侦察",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'k8s-object', 'selector': 'DaemonSet/ztunnel'}",
      "{'type': 'runtime-agent', 'selector': 'ztunnel'}",
      "{'type': 'http-endpoint', 'selector': '/healthz/ready'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {},
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "host",
      "op": "fs",
      "action": "stat",
      "path": "/",
      "save": "host",
      "allow_failure": true
    }
  ],
  "checks": [
    {
      "id": "host-readable",
      "when": "steps.host.exists == true",
      "message": "probe filesystem is not readable"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "true",
      "sev": "high",
      "title": "ztunnel 使用 hostNetwork，mesh 数据面绕开 Pod 网络隔离",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md ambient mesh 面",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "true",
      "sev": "low",
      "title": "ztunnel 健康端点未授权可达（版本与就绪信息泄露）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md ambient mesh 面",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "true",
      "sev": "medium",
      "title": "命名空间未加入 ambient mesh，东西向流量不受 ztunnel 策略约束",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md ambient mesh 面",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "ambient-mesh-audit-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
