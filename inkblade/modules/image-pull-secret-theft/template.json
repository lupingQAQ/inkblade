{
  "schema": "inkblade-probe-template-v1",
  "key": "image-pull-secret-theft",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "imagePullSecret 窃取",
      "en": "imagePullSecret theft"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  },
  "computed": {
    "docker": "filter(steps.snapshot.json.secrets, it.type == 'kubernetes.io/dockerconfigjson')",
    "pods": "filter(steps.snapshot.json.pods, it.imagePullSecrets != null)"
  },
  "findings": [
    {
      "id": "secret",
      "for_each": "computed.docker",
      "as": "sec",
      "sev": "high",
      "title": "imagePullSecret 可读：{{sec.name}}",
      "detail": "dockerconfigjson 含仓库凭据；可拉取私有镜像或向仓库推送恶意镜像，投毒 operator/DaemonSet。",
      "evidence": "secret={{sec.name}} type={{sec.type}}",
      "mapping": "提权矩阵 cred-image-pull-secret；MITRE T1525",
      "fix": "使用短时效 registry token/工作负载身份；限制 secrets 读权限到拉取组件"
    },
    {
      "id": "pod",
      "for_each": "computed.pods",
      "as": "pod",
      "sev": "medium",
      "title": "Pod 引用 imagePullSecret：{{pod.name}}",
      "detail": "imagePullSecrets={{str(pod.imagePullSecrets)}}；可被 exec/探针读取或滥用。",
      "evidence": "pod={{pod.name}}",
      "fix": "改用节点级/仓库联合身份；避免长期静态 dockerconfigjson"
    }
  ],
  "artifacts": [
    {
      "name": "image-pull-secret-theft-detection.json",
      "kind": "json",
      "fields": {
        "secrets": "map(computed.docker, it.name)",
        "pods": "map(computed.pods, it.name)"
      }
    }
  ]
}
