{
  "schema": "inkblade-probe-template-v1",
  "key": "agent-skill-registry-supply-chain",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "Agent Skill 注册表供应链检查",
      "en": "Agent skill registry supply-chain check"
    },
    "series": "情报",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'config-file', 'selector': 'agent/skills/registry.json'}",
      "{'type': 'http-endpoint', 'selector': '/skills/registry'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
