      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R02 / I08,I35,I54",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "Skill 文档包含可疑指令：{skill.get(",
