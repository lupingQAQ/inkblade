{
  "schema": "inkblade-probe-template-v1",
  "key": "apiservice-hijack",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "APIService 聚合劫持",
      "en": "APIService aggregation hijack"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  },
  "computed": {
    "risky": "filter(steps.snapshot.json.apiservices, it.insecureSkipTLSVerify == true or it.service == null)"
  },
  "findings": [
    {
      "id": "apiservice",
      "for_each": "computed.risky",
      "as": "svc",
      "sev": "high",
      "title": "APIService 聚合层不安全：{{svc.name}}",
      "detail": "insecureSkipTLSVerify={{svc.insecureSkipTLSVerify}} service={{str(svc.service)}}；可劫持 API group、窃取 bearer token 或伪造对象。",
      "evidence": "apiservice={{svc.name}} group={{svc.group}}",
      "mapping": "提权矩阵 rbac-apiservice-hijack；K8s aggregation",
      "fix": "启用 TLS 校验、绑定 service；限制 apiservices 写权限到控制面组件"
    }
  ],
  "artifacts": [
    {
      "name": "apiservice-hijack-detection.json",
      "kind": "json",
      "fields": {
        "risky": "map(computed.risky, it.name)"
      }
    }
  ]
}
