{
  "schema": "inkblade-probe-template-v1",
  "key": "aigateway-upstream-key-exfil",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 网关上游 provider key 外泄",
      "en": "AI Gateway Upstream Provider Key Exfiltration"
    },
    "series": "窃取与数据泄露",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab-only probe"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 24
  },
  "computed": {
    "anon_config": "steps.config.status == 200 and steps.config.json.redacted != true",
    "upstreams": "count(steps.config.json.upstreams)",
    "plain_key": "len(str(steps.config.json.upstreams[0].api_key)) > 8 and not contains(str(steps.config.json.upstreams[0].api_key), '****')",
    "global_keys": "steps.keyinfo.status == 200 and steps.keyinfo.json.scope == 'global'"
  },
  "steps": [
    {
      "id": "config",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/config",
      "save": "config",
      "allow_failure": true
    },
    {
      "id": "keyinfo",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/key/info",
      "headers": {
        "Authorization": "Bearer MOCK-tenant-a-key-a1b2",
        "X-Tenant": "tenant-a"
      },
      "save": "keyinfo",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "exfil",
      "when": "computed.anon_config and (computed.plain_key or computed.global_keys)",
      "sev": "critical",
      "title": "上游 provider key 未鉴权可读：AI 网关配置面泄漏",
      "detail": "upstreams={{computed.upstreams}} plain_key={{computed.plain_key}} key_scope={{steps.keyinfo.json.scope}} master_key_present={{steps.config.json.master_key != null}}",
      "evidence": "{{steps.config.sha256}}",
      "mapping": "OWASP LLM06/ASI03",
      "fix": "配置面仅管理面可读；上游 key 只存 KMS/Secret 引用并脱敏"
    },
    {
      "id": "clean",
      "when": "not (computed.anon_config and (computed.plain_key or computed.global_keys))",
      "sev": "info",
      "title": "上游 key 已脱敏/配置面鉴权生效",
      "detail": "config_status={{steps.config.status}} redacted={{steps.config.json.redacted}}"
    }
  ],
  "artifacts": [
    {
      "name": "aigateway-upstream-key-exfil.json",
      "kind": "json",
      "fields": {
        "anon_config": "computed.anon_config",
        "upstreams": "computed.upstreams",
        "plain_key": "computed.plain_key",
        "key_scope": "steps.keyinfo.json.scope"
      }
    }
  ]
}
