{
  "schema": "inkblade-probe-template-v1",
  "key": "kubehound-token-edges",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "KubeHound Token 边",
      "en": "KubeHound token edges"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "TOKEN_STEAL：{subject} 可读取 SA token（{len(automount)} 个 automount Pod）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "KubeHound TOKEN_*.md + CM-08",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "TOKEN_STEAL：{subject} 可读取 Secret（无 automount 先例）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "KubeHound TOKEN_*.md + CM-08",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "TOKEN_LIST：{subject} 可枚举全部 Secret（{len(secrets)} 个）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "KubeHound TOKEN_*.md + CM-08",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "TOKEN_BRUTEFORCE：{len(predictable)} 个 token 名称可枚举 × list 权限",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "KubeHound TOKEN_*.md + CM-08",
      "fix": ""
    },
    {
      "id": "f5",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "TOKEN_BRUTEFORCE 面：{len(create_pods)} 个主体可建 Pod（可挂载任意 SA token）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "KubeHound TOKEN_*.md + CM-08",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "kubehound-token-edges-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
