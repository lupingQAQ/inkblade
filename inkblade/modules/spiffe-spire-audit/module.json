  "min_level": "主动探测",
  "writes": false,
  "requires": [],
  "params_schema": {
    "collect": "trident collect 输出目录",
    "profile": "部署画像名"
  },
  "produces": "spiffe-spire-audit.json + 身份面 findings",
  "knowledge": "docs/SURFACE-REALISM.md SPIFFE/SPIRE 面",
  "combo_signature": "spire-registration-api-open",
  "surfaces": [
    {"type": "k8s-object", "selector": "Deployment/spire-server"},
    {"type": "runtime-agent", "selector": "spire-agent"},
    {"type": "config-file", "selector": "spire"}
  ],
  "default_enabled": true
