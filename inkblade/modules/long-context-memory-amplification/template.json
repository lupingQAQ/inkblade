{
  "schema": "inkblade-probe-template-v1",
  "key": "long-context-memory-amplification",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "长上下文内存放大",
      "en": "Long-context memory amplification"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "computed": {
    "kv_before": "steps.before.json.kv_cache_bytes",
    "kv_after": "steps.after.json.kv_cache_bytes",
    "delta": "steps.after.json.kv_cache_bytes - steps.before.json.kv_cache_bytes",
    "amplified": "steps.after.json.kv_cache_bytes - steps.before.json.kv_cache_bytes > 50000"
  },
  "steps": [
    {
      "id": "before",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "before",
      "allow_failure": true
    },
    {
      "id": "chat",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "model": "longctx-mock",
        "max_tokens": 1,
        "prompt_tokens": 32768,
        "messages": [
          {
            "role": "user",
            "content": "INKBLADE-BENIGN memory amplification"
          }
        ]
      },
      "save": "chat",
      "allow_failure": true
    },
    {
      "id": "after",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "after",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "amplify",
      "when": "steps.chat.status == 200 and computed.amplified",
      "sev": "medium",
      "title": "长上下文 KV 预留放大：单请求显著抬升 KV 占用",
      "detail": "kv_before={{computed.kv_before}} kv_after={{computed.kv_after}} delta={{computed.delta}}",
      "evidence": "{{steps.after.sha256}}",
      "mapping": "long-context-memory-amplification",
      "fix": "按实际 prompt+decode 预留；KV 池配额与驱逐策略"
    },
    {
      "id": "clean",
      "when": "not (steps.chat.status == 200 and computed.amplified)",
      "sev": "info",
      "title": "KV 预留按实际 token 计算",
      "detail": "delta={{computed.delta}}"
    }
  ],
  "artifacts": [
    {
      "name": "long-context-memory-amplification.json",
      "kind": "json",
      "fields": {
        "kv_before": "computed.kv_before",
        "kv_after": "computed.kv_after",
        "delta": "computed.delta"
      }
    }
  ]
}
