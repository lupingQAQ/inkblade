{
  "schema": "inkblade-probe-template-v1",
  "key": "lws-secrets-lateral",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "LWS 集群级 Secrets 横向",
      "en": "LWS Cluster-scoped Secrets Lateral"
    },
    "series": "权限链",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "fixture": {
      "from": "params.fixture",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：LWS/LeaderWorkerSet 集群级 secrets 读写与节点 patch",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "ClusterRole「{name}」可集群级读 Secrets 并 patch 节点（横向原语）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：LWS/LeaderWorkerSet 集群级 secrets 读写与节点 patch",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "ClusterRole「{name}」具备集群级 Secrets 读权",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：LWS/LeaderWorkerSet 集群级 secrets 读写与节点 patch",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "集群级 Secrets 读取演示已执行（backup-write + 可回滚）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：LWS/LeaderWorkerSet 集群级 secrets 读写与节点 patch",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "lws-secrets-lateral-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "write-surface demo; requires backup receipt"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  }
}
