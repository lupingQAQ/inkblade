{
  "schema": "inkblade-probe-template-v1",
  "key": "privileged-gpu-pod-escape",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "特权 GPU Pod 宿主逃逸",
      "en": "Privileged GPU Pod Host Escape"
    },
    "series": "权限链",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "fixture": {
      "from": "params.fixture",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    },
    {
      "id": "demo",
      "op": "fs",
      "action": "write",
      "write": true,
      "when": "params.mode == 'backup-write'",
      "path": "{{params.demo_target}}",
      "content": "# INKBLADE demo {{ctx.marker}} privileged pod\napiVersion: v1\nkind: Pod\nmetadata: {name: inkblade-privileged-demo}\nspec: {hostNetwork: true, containers: [{name: c, image: busybox, securityContext: {privileged: true}}]}\n",
      "save": "demo"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：四框架特权部署（hostPath/socket/caps/设备组合逃逸）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "Pod「{name}」特权原语组合可宿主逃逸",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：四框架特权部署（hostPath/socket/caps/设备组合逃逸）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "宿主逃逸 marker 证明已写入（backup-write + 可回滚）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：四框架特权部署（hostPath/socket/caps/设备组合逃逸）",
      "fix": ""
    },
    {
      "id": "demo-written",
      "when": "params.mode == 'backup-write'",
      "sev": "high",
      "title": "特权 Pod 清单写入演示已落盘（可回滚）",
      "detail": "演示清单写入 {{params.demo_target}}；真实集群中由 create pods 生效。",
      "evidence": "demo_target={{params.demo_target}}",
      "mapping": "privileged-gpu-pod-escape demo"
    }
  ],
  "artifacts": [
    {
      "name": "privileged-gpu-pod-escape-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "write-surface demo; requires backup receipt"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  }
}
