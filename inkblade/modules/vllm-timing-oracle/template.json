{
  "schema": "inkblade-probe-template-v1",
  "key": "vllm-timing-oracle",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "vLLM API key timing surface",
      "en": "vLLM API key timing surface"
    },
    "series": "核心代码",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [
      "CVE-2025-59425"
    ],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 5000,
    "tls_verify": false
  },
  "computed": {
    "success": "steps.models.status == 200 or steps.models.status == 201"
  },
  "steps": [
    {
      "id": "metrics",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/vllm/metrics",
      "save": "metrics",
      "allow_failure": true
    },
    {
      "id": "models",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/vllm/models",
      "save": "models",
      "allow_failure": true
    },
    {
      "id": "cleanup",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/__cleanup__",
      "body": {
        "marker": "{{ctx.marker}}"
      },
      "save": "cleanup",
      "allow_failure": true,
      "when": "params.cleanup != false"
    }
  ],
  "checks": [
    {
      "id": "target-answered",
      "when": "steps.models.status != null",
      "message": "target did not answer"
    }
  ],
  "findings": [
    {
      "id": "cve",
      "when": "computed.success",
      "sev": "high",
      "title": "vLLM API key 未强制：时序侧信道可枚举",
      "detail": "{\"http_status\": 200, \"metrics_has_mooncake\": false, \"models_unauth\": true, \"route\": \"\", \"cves\": [\"CVE-2025-59425\"], \"exploit_level\": \"read-only\", \"fix\": \"升级 >=0.11.0rc2（常量时间比较）并强制 api-key\", \"verified\": false, \"verification_status\": \"static-only\", \"verified_cves\": [], \"unverified_cves\": [\"CVE-2025-59425\"], \"verification_cves\": {\"CVE-2025-59425\": \"static-only\"}, \"verification_evidence\": []}",
      "cves": [
        "CVE-2025-59425"
      ],
      "evidence": "{{steps.models.sha256}}",
      "mapping": "CVE arsenal / exploit-registry",
      "fix": "升级 >=0.11.0rc2（常量时间比较）并强制 api-key",
      "version_matrix": {
        "product": "vllm",
        "source": "steps.models.json.version",
        "vulnerable": [
          "*"
        ],
        "note": "CVE-linked version range; refine per advisory"
      }
    },
    {
      "id": "clean",
      "when": "not computed.success",
      "sev": "info",
      "title": "vllm-timing-oracle: 未观察到可利用响应（fixed/未部署）",
      "detail": "step=models status={{steps.models.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "vllm-timing-oracle-trace.json",
      "kind": "json",
      "fields": {
        "module": "'vllm-timing-oracle'",
        "success": "computed.success",
        "cves": "[\"CVE-2025-59425\"]",
        "exploit_step": "'models'",
        "status": "steps.models.status"
      }
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab replay only"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 32
  }
}
