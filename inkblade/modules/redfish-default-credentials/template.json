{
  "schema": "inkblade-probe-template-v1",
  "key": "redfish-default-credentials",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "Redfish default credentials",
      "en": "Redfish default credentials"
    },
    "series": "网络架构",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [
      "CVE-2023-34329",
      "CVE-2017-12542"
    ],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 5000,
    "tls_verify": false
  },
  "computed": {
    "success": "steps.systems.status == 200 or steps.systems.status == 201"
  },
  "steps": [
    {
      "id": "root",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/redfish/v1",
      "save": "root",
      "allow_failure": true
    },
    {
      "id": "login",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/redfish/v1/SessionService/Sessions",
      "save": "login",
      "allow_failure": true,
      "headers": {
        "Authorization": "Basic YWRtaW46YWRtaW4="
      }
    },
    {
      "id": "systems",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/redfish/v1/Systems/1",
      "save": "systems",
      "allow_failure": true,
      "headers": {
        "X-Auth-Token": ""
      }
    },
    {
      "id": "cleanup",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/__cleanup__",
      "body": {
        "marker": "{{ctx.marker}}"
      },
      "save": "cleanup",
      "allow_failure": true,
      "when": "params.cleanup != false"
    }
  ],
  "checks": [
    {
      "id": "target-answered",
      "when": "steps.systems.status != null",
      "message": "target did not answer"
    }
  ],
  "findings": [
    {
      "id": "cve",
      "when": "computed.success",
      "sev": "critical",
      "title": "Redfish 默认凭据登录：BMC 管理员会话",
      "detail": "{\"session_status\": 200, \"accepted_username\": null, \"token_issued\": false, \"systems_status\": 200, \"systems\": null, \"default_credential\": true, \"cves\": [\"REDFISH-DEFAULT-CREDS\", \"CVE-2023-34329\", \"CVE-2017-12542\"], \"exploit_level\": \"full-mock\", \"fix\": \"轮换 BMC 默认口令/启用强认证与网络隔离\", \"verified\": false, \"verification_status\": \"unverified\", \"verified_cves\": [], \"unverified_cves\": [\"REDFISH-DEFAULT-CREDS\", \"CVE-2023-34329\", \"CVE-2017-12542\"], \"verification_cves\": {\"REDFISH-DEFAULT-CREDS\": \"unknown\", \"CVE-2023-34329\": \"unsupported\", \"CVE-2017-12542\": \"unsupported\"}, \"verification_evidence\": []}",
      "cves": [
        "REDFISH-DEFAULT-CREDS",
        "CVE-2023-34329",
        "CVE-2017-12542"
      ],
      "evidence": "{{steps.systems.sha256}}",
      "mapping": "CVE arsenal / exploit-registry",
      "fix": "轮换 BMC 默认口令/启用强认证与网络隔离",
      "version_matrix": {
        "product": "redfish",
        "source": "steps.systems.json.version",
        "vulnerable": [
          "*"
        ],
        "note": "CVE-linked version range; refine per advisory"
      }
    },
    {
      "id": "clean",
      "when": "not computed.success",
      "sev": "info",
      "title": "redfish-default-credentials: 未观察到可利用响应（fixed/未部署）",
      "detail": "step=systems status={{steps.systems.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "redfish-default-credentials-trace.json",
      "kind": "json",
      "fields": {
        "module": "'redfish-default-credentials'",
        "success": "computed.success",
        "cves": "[\"REDFISH-DEFAULT-CREDS\", \"CVE-2023-34329\", \"CVE-2017-12542\"]",
        "exploit_step": "'systems'",
        "status": "steps.systems.status"
      }
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab replay only"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 32
  }
}
