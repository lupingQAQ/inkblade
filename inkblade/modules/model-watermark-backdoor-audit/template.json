{
  "schema": "inkblade-probe-template-v1",
  "key": "model-watermark-backdoor-audit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "模型水印/后门服务面审计",
      "en": "Model watermark/backdoor service surface audit"
    },
    "series": "侦察",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'http-endpoint', 'selector': '/watermark'}",
      "{'type': 'model-file', 'selector': 'watermark'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {},
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "host",
      "op": "fs",
      "action": "stat",
      "path": "/",
      "save": "host",
      "allow_failure": true
    }
  ],
  "checks": [
    {
      "id": "host-readable",
      "when": "steps.host.exists == true",
      "message": "probe filesystem is not readable"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "true",
      "sev": "medium",
      "title": "模型水印/验收服务未授权可达",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md no-surface 模块隔离",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "true",
      "sev": "high",
      "title": "模型元数据包含触发器/后门标记",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md no-surface 模块隔离",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "model-watermark-backdoor-audit-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
