{
  "schema": "inkblade-probe-template-v1",
  "key": "context-limit-bypass",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "上下文上限绕过",
      "en": "Context limit bypass"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "computed": {
    "prefill": "steps.chat.json.usage.prefill_tokens",
    "window": "steps.chat.json.context_window",
    "over": "steps.chat.json.usage.prefill_tokens > steps.chat.json.context_window",
    "accepted": "steps.chat.status == 200"
  },
  "steps": [
    {
      "id": "before",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "before",
      "allow_failure": true
    },
    {
      "id": "chat",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "model": "longctx-mock",
        "max_tokens": 8,
        "prompt_tokens": 200000,
        "context_window": 131072,
        "messages": [
          {
            "role": "user",
            "content": "INKBLADE-BENIGN over-window probe"
          }
        ]
      },
      "save": "chat",
      "allow_failure": true
    },
    {
      "id": "after",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "after",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "bypass",
      "when": "computed.accepted and computed.over",
      "sev": "high",
      "title": "上下文窗口上限被绕过：超窗 prompt 仍被接受",
      "detail": "prefill={{computed.prefill}} window={{computed.window}} finish={{steps.chat.json.choices[0].finish_reason}} queue={{steps.chat.json.queue_depth}}",
      "evidence": "{{steps.chat.sha256}}",
      "mapping": "long-context-window-exhaustion",
      "fix": "在 tokenizer 层强制 prompt_tokens <= context_window；超窗 400"
    },
    {
      "id": "clean",
      "when": "not (computed.accepted and computed.over)",
      "sev": "info",
      "title": "上下文窗口上限生效",
      "detail": "status={{steps.chat.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "context-limit-bypass.json",
      "kind": "json",
      "fields": {
        "prefill": "computed.prefill",
        "window": "computed.window",
        "over": "computed.over",
        "accepted": "computed.accepted"
      }
    }
  ]
}
