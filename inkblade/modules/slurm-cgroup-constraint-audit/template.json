{
  "schema": "inkblade-probe-template-v1",
  "key": "slurm-cgroup-constraint-audit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "Slurm cgroup 资源与设备约束审计",
      "en": "Slurm cgroup resource and device constraint audit"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'config-file', 'selector': 'slurm/cgroup.conf'}",
      "{'type': 'runtime-agent', 'selector': 'runtime-agent/cgroup'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "cgroup 插件被禁用",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD cgroup.conf(5) / proctrack/cgroup；docs/SLURM-HPC-COVERAGE.md cgroup 面",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "未限制作业 CPU 核集（ConstrainCores=no）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD cgroup.conf(5) / proctrack/cgroup；docs/SLURM-HPC-COVERAGE.md cgroup 面",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "未限制作业内存（ConstrainRAMSpace=no）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD cgroup.conf(5) / proctrack/cgroup；docs/SLURM-HPC-COVERAGE.md cgroup 面",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "未限制 swap（ConstrainSwapSpace=no）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD cgroup.conf(5) / proctrack/cgroup；docs/SLURM-HPC-COVERAGE.md cgroup 面",
      "fix": ""
    },
    {
      "id": "f5",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "未限制设备访问（ConstrainDevices=no）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD cgroup.conf(5) / proctrack/cgroup；docs/SLURM-HPC-COVERAGE.md cgroup 面",
      "fix": ""
    },
    {
      "id": "f6",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "AllowedRAMSpace 超过分配量",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD cgroup.conf(5) / proctrack/cgroup；docs/SLURM-HPC-COVERAGE.md cgroup 面",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "slurm-cgroup-constraint-audit-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
