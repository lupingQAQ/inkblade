{
  "schema": "inkblade-probe-template-v1",
  "key": "csi-node-plugin-escape",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "CSI node plugin 逃逸",
      "en": "CSI node plugin escape"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  },
  "computed": {
    "csi": "filter(steps.snapshot.json.daemonsets, (contains(lower(it.name), 'csi') or contains(lower(str(it.image)), 'nfsplugin')) and (it.privileged == true or contains(str(it.hostPath), '/var/lib/kubelet') or contains(str(it.hostPath), '/dev')))"
  },
  "findings": [
    {
      "id": "csi",
      "for_each": "computed.csi",
      "as": "ds",
      "sev": "critical",
      "title": "CSI node plugin 逃逸面：{{ds.name}}",
      "detail": "privileged={{ds.privileged}} hostPath={{str(ds.hostPath)}}；插件可读写宿主 kubelet 目录/设备，篡改挂载流程或跨租户读取卷。",
      "evidence": "daemonset={{ds.name}} sa={{ds.serviceAccount}}",
      "mapping": "提权矩阵 platform-csi-node-plugin；CSI 规范",
      "fix": "CSI 插件按最小 hostPath 收敛；启用卷隔离/加密；插件镜像签名与准入校验"
    }
  ],
  "artifacts": [
    {
      "name": "csi-node-plugin-escape-detection.json",
      "kind": "json",
      "fields": {
        "csi": "map(computed.csi, it.name)"
      }
    }
  ]
}
