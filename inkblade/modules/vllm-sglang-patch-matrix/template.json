{
  "schema": "inkblade-probe-template-v1",
  "key": "vllm-sglang-patch-matrix",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "vLLM/SGLang 版本补丁差异矩阵",
      "en": "vLLM/SGLang Patch-Difference Matrix"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {},
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "host",
      "op": "fs",
      "action": "stat",
      "path": "/",
      "save": "host",
      "allow_failure": true
    }
  ],
  "checks": [
    {
      "id": "host-readable",
      "when": "steps.host.exists == true",
      "message": "probe filesystem is not readable"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "true",
      "sev": "critical",
      "title": "high",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/DEPTH-REVIEW.md §1；corpus/depth/vllm_patch_matrix.json",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "true",
      "sev": "medium",
      "title": "component} {version} 命中 {len(hits)} 条 CVE/补丁差异（接口面",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/DEPTH-REVIEW.md §1；corpus/depth/vllm_patch_matrix.json",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "vllm-sglang-patch-matrix-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
