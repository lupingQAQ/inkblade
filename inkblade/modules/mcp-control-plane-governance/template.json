{
  "schema": "inkblade-probe-template-v1",
  "key": "mcp-control-plane-governance",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "MCP 控制面与工具权限治理检查",
      "en": "MCP control-plane and tool permission governance check"
    },
    "series": "权限链",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'config-file', 'selector': 'mcp/servers.json'}",
      "{'type': 'http-endpoint', 'selector': '/mcp/tools'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "MCP 注册表未强制 server/工具清单签名",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R04 / I21,I37",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "MCP 注册表未配置发布者 allowlist",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R04 / I21,I37",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "mcp-control-plane-governance-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
