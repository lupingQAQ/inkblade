{
  "schema": "inkblade-probe-template-v1",
  "key": "kube-audit-trail-analysis",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "K8s 审计轨迹分析",
      "en": "K8s audit trail analysis"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {},
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "host",
      "op": "fs",
      "action": "stat",
      "path": "/",
      "save": "host",
      "allow_failure": true
    }
  ],
  "checks": [
    {
      "id": "host-readable",
      "when": "steps.host.exists == true",
      "message": "probe filesystem is not readable"
    }
  ],
  "findings": [
    {
      "id": "observed",
      "when": "true",
      "sev": "info",
      "title": "K8s 审计轨迹分析：部署面已观测",
      "detail": "Template executed and the declared surface responded; no exploitable condition asserted.",
      "evidence": "steps"
    }
  ],
  "artifacts": [
    {
      "name": "kube-audit-trail-analysis-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
