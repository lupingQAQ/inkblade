{
  "schema": "inkblade-probe-template-v1",
  "key": "long-context-training-collective-surface",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "大规模训练集合通信面",
      "en": "Large-scale training collective surface"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "medium",
      "title": "大规模训练并行拓扑与集合通信端口暴露（ring attention / 层级 all-reduce）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/LONG-CONTEXT.md 第 1 节：TP/PP/EP/CP/SP、ring attention、层级 all-reduce 与 A1–A8 万卡假设；spec 5.2 网络架构层",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "训练拓扑未暴露或指标面需鉴权（集合通信面收敛）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/LONG-CONTEXT.md 第 1 节：TP/PP/EP/CP/SP、ring attention、层级 all-reduce 与 A1–A8 万卡假设；spec 5.2 网络架构层",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "long-context-training-collective-surface-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
