{
  "schema": "inkblade-probe-template-v1",
  "key": "long-context-training-collective-surface",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "大规模训练集合通信面",
      "en": "Large-scale training collective surface"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "computed": {
    "metrics_ok": "steps.metrics.status == 200",
    "training": "steps.metrics.json.training",
    "exposed": "steps.metrics.status == 200 and steps.metrics.json.training != null"
  },
  "steps": [
    {
      "id": "metrics",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "metrics",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "exposed",
      "when": "computed.exposed",
      "sev": "medium",
      "title": "训练/集合通信配置随 metrics 暴露",
      "detail": "training={{str(steps.metrics.json.training)}} decode_pool={{str(steps.metrics.json.decode_pool)}}",
      "evidence": "{{steps.metrics.sha256}}",
      "mapping": "long-context-training-collective-surface",
      "fix": "metrics 拆分公开/管理面；训练拓扑与集合通信参数仅管理面可见"
    },
    {
      "id": "clean",
      "when": "not computed.exposed",
      "sev": "info",
      "title": "metrics 未暴露训练集合通信配置",
      "detail": "status={{steps.metrics.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "long-context-training-collective-surface.json",
      "kind": "json",
      "fields": {
        "exposed": "computed.exposed",
        "training": "steps.metrics.json.training",
        "queue_depth": "steps.metrics.json.queue_depth"
      }
    }
  ]
}
