{
  "schema": "inkblade-probe-template-v1",
  "key": "megatron-deepspeed-config-surface",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "Megatron/DeepSpeed 训练配置面调查",
      "en": "Megatron/DeepSpeed training config surface"
    },
    "series": "侦察",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.surface.ok == true",
      "sev": "high",
      "title": "Megatron/DeepSpeed 训练配置面暴露：并行度/共享 checkpoint 路径/令牌类环境变量可读",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/PRETRAIN-SFT-RL-COVERAGE.md 第 1 节：预训练栈配置面（并行度/checkpoint/环境注入）；Megatron-LM core_v0.19.2 与 DeepSpeed v0.19.8 只读快照",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.surface.ok == true",
      "sev": "info",
      "title": "训练配置面被拒绝或未满足暴露判据（配置 401 / 并行度不全 / 无敏感环境变量）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/PRETRAIN-SFT-RL-COVERAGE.md 第 1 节：预训练栈配置面（并行度/checkpoint/环境注入）；Megatron-LM core_v0.19.2 与 DeepSpeed v0.19.8 只读快照",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "megatron-deepspeed-config-surface-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
