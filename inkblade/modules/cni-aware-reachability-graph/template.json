{
  "schema": "inkblade-probe-template-v1",
  "key": "cni-aware-reachability-graph",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "CNI 语义可达性图",
      "en": "CNI-aware Reachability Graph"
    },
    "series": "网络架构",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [
      "fabric-topology-isolation",
      "cni-stack-capability",
      "multus-sriov-rdma-bypass",
      "collective-communication-surface",
      "gpu-network-operator-posture",
      "inference-gateway-pd",
      "storage-protocol-csi",
      "dns-service-discovery",
      "scheduler-network-semantics"
    ],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "observed",
      "when": "steps.snapshot.exists == true",
      "sev": "info",
      "title": "CNI 语义可达性图：部署面已观测",
      "detail": "Template executed and the declared surface responded; no exploitable condition asserted.",
      "evidence": "steps"
    }
  ],
  "artifacts": [
    {
      "name": "cni-aware-reachability-graph-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
