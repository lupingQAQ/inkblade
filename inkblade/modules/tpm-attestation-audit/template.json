{
  "schema": "inkblade-probe-template-v1",
  "key": "tpm-attestation-audit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "TPM/证明链面审计",
      "en": "TPM and attestation-chain surface audit"
    },
    "series": "侦察",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'bmc', 'selector': 'tpm'}",
      "{'type': 'config-file', 'selector': 'attest'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {},
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "host",
      "op": "fs",
      "action": "stat",
      "path": "/",
      "save": "host",
      "allow_failure": true
    }
  ],
  "checks": [
    {
      "id": "host-readable",
      "when": "steps.host.exists == true",
      "message": "probe filesystem is not readable"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "true",
      "sev": "high",
      "title": "节点存在 TPM 但证明链被显式关闭",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md TPM/证明面",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "true",
      "sev": "medium",
      "title": "TPM 存在但缺少 EK/AK 或 PCR 基线证据",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md TPM/证明面",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "true",
      "sev": "info",
      "title": "TPM 已采集但未提供 measured-boot 策略，证明链未验证",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md TPM/证明面",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "tpm-attestation-audit-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
