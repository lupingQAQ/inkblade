{
  "schema": "inkblade-probe-template-v1",
  "key": "sglang-admin-failopen",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "SGLang 管理面 fail-open",
      "en": "SGLang Admin Plane Fail-open"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/pause",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe2",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/freeze",
      "headers": {},
      "save": "probe2",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe3",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/resume",
      "headers": {},
      "save": "probe3",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe4",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/update_weights_from_disk",
      "headers": {},
      "save": "probe4",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/design.md 第 1–5 节：SGLang 管理面 fail-open",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "SGLang 管理面 fail-open：无管理密钥放行暂停/恢复",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/design.md 第 1–5 节：SGLang 管理面 fail-open",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "sglang-admin-failopen-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
