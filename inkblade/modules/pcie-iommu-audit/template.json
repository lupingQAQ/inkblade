{
  "schema": "inkblade-probe-template-v1",
  "key": "pcie-iommu-audit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "PCIe/IOMMU 直通隔离面审计",
      "en": "PCIe/IOMMU passthrough isolation audit"
    },
    "series": "侦察",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'k8s-object', 'selector': 'Node'}",
      "{'type': 'config-file', 'selector': 'iommu'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {},
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "host",
      "op": "fs",
      "action": "stat",
      "path": "/",
      "save": "host",
      "allow_failure": true
    }
  ],
  "checks": [
    {
      "id": "host-readable",
      "when": "steps.host.exists == true",
      "message": "probe filesystem is not readable"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "true",
      "sev": "high",
      "title": "节点 IOMMU 关闭，PCIe 直通设备无法按租户隔离",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md PCIe/IOMMU 面",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "true",
      "sev": "high",
      "title": "PCIe ACS 关闭，同组设备可绕过 IOMMU 分组",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md PCIe/IOMMU 面",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "true",
      "sev": "medium",
      "title": "多个设备共享 IOMMU 组并整组直通到单一租户",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md PCIe/IOMMU 面",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "true",
      "sev": "info",
      "title": "节点已采集但 IOMMU 运行态未验证，需补采 /sys/kernel/iommu_groups 与内核参数",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/SURFACE-REALISM.md PCIe/IOMMU 面",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "pcie-iommu-audit-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
