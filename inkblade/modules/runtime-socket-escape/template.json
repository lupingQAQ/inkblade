  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：运行时 socket 挂载逃逸（docker.sock/containerd.sock → 宿主特权容器）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "Pod「{name}」挂载容器运行时 socket（宿主逃逸原语）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：运行时 socket 挂载逃逸（docker.sock/containerd.sock → 宿主特权容器）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "运行时 socket 逃逸 marker 证明已写入（backup-write + 可回滚）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 11 节：运行时 socket 挂载逃逸（docker.sock/containerd.sock → 宿主特权容器）",
      "fix": ""
    }
