{
  "schema": "inkblade-probe-template-v1",
  "key": "runtime-socket-escape",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "容器运行时 Socket 逃逸",
      "en": "Runtime Socket Escape"
    },
    "series": "权限链",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
