{
  "schema": "inkblade-probe-template-v1",
  "key": "cache-timing-sidechannel",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "缓存命中时序侧信道（成员推断）",
      "en": "Cache timing side channel (membership inference)"
    },
    "series": "窃取与数据泄露",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "样本不足（N={n_total}<{MIN_TOTAL_SAMPLES}），显著性断言不成立",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/CACHE-SECURITY.md 第 4 节：时序侧信道（NDSS'25 PROMPTPEEK / SafeKV 研究对标）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "前缀缓存时序侧信道：TTFT 差分 {round(delta, 1)}ms（p={stats[",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/CACHE-SECURITY.md 第 4 节：时序侧信道（NDSS'25 PROMPTPEEK / SafeKV 研究对标）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "未观察到显著 TTFT 差分（Δ={round(delta, 1)}ms，p={stats[",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/CACHE-SECURITY.md 第 4 节：时序侧信道（NDSS'25 PROMPTPEEK / SafeKV 研究对标）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "cache-timing-sidechannel-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
