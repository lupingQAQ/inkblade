{
  "schema": "inkblade-probe-template-v1",
  "key": "checkpoint-shard-poison",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "checkpoint 分片投毒",
      "en": "Checkpoint shard poisoning"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  },
  "computed": {
    "exists": "steps.read.status == 200",
    "marker": "contains(steps.read.text, 'INKBLADE')",
    "write_ok": "steps.write.status == 200",
    "readback_marker": "contains(steps.readback.text, 'INKBLADE')"
  },
  "steps": [
    {
      "id": "metrics",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "metrics",
      "allow_failure": true
    },
    {
      "id": "read",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/checkpoint/shards/shard-00000",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "read",
      "allow_failure": true
    },
    {
      "id": "write",
      "op": "http",
      "method": "POST",
      "write": true,
      "when": "params.mode == 'backup-write'",
      "url": "{{input.target}}/checkpoint/shards",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "shard_id": "poison-{{ctx.marker}}",
        "payload": "INKBLADE-BENIGN-SHARD {{ctx.marker}}"
      },
      "save": "write",
      "allow_failure": true
    },
    {
      "id": "readback",
      "op": "http",
      "method": "GET",
      "when": "params.mode == 'backup-write'",
      "url": "{{input.target}}/checkpoint/shards/poison-{{ctx.marker}}",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "readback",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "read",
      "when": "steps.metrics.status == 200 and computed.exists and computed.marker",
      "sev": "high",
      "title": "checkpoint shard 可跨租户读取（含训练数据标记）",
      "detail": "shard=shard-00001 status={{steps.read.status}} marker={{computed.marker}}",
      "evidence": "{{steps.read.sha256}}",
      "mapping": "checkpoint-shard-poison",
      "fix": "shard 存储按租户/作业隔离；读取鉴权"
    },
    {
      "id": "poison",
      "when": "params.mode == 'backup-write' and computed.write_ok and computed.readback_marker",
      "sev": "high",
      "title": "checkpoint shard 可写并读回：训练数据投毒路径",
      "detail": "shard=poison-{{ctx.marker}} readback_marker={{computed.readback_marker}}",
      "evidence": "{{steps.readback.sha256}}",
      "mapping": "checkpoint-shard-poison",
      "fix": "checkpoint 写入仅训练作业 SA；内容签名+版本 pinning"
    }
  ],
  "artifacts": [
    {
      "name": "checkpoint-shard-poison.json",
      "kind": "json",
      "fields": {
        "exists": "computed.exists",
        "marker": "computed.marker",
        "readback_marker": "computed.readback_marker",
        "mode": "params.mode"
      }
    }
  ]
}
