{
  "schema": "inkblade-probe-template-v1",
  "key": "llm2jev-file-read",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "llm2jev image_url 本地文件读取",
      "en": "llm2jev image_url Local File Read"
    },
    "series": "窃取与数据泄露",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'http-endpoint', 'selector': '/v1/systemone'}",
      "{'type': 'config-file', 'selector': 'llm2jev'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/v1/models",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe2",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {},
      "save": "probe2",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "medium",
      "title": "fix",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/WEAPON-READINESS.md#llm2jev-file-read",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "llm2jev-file-read-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
