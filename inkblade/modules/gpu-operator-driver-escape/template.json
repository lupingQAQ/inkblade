{
  "schema": "inkblade-probe-template-v1",
  "key": "gpu-operator-driver-escape",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "GPU Operator driver 逃逸",
      "en": "GPU driver container escape"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  },
  "computed": {
    "driver": "filter(steps.snapshot.json.daemonsets, (contains(lower(it.name), 'driver') or contains(lower(str(it.image)), 'nvidia/driver')) and (it.privileged == true or contains(str(it.hostPath), '/dev') or contains(str(it.hostPath), '/run') or contains(str(it.hostPath), '/usr/lib64')))"
  },
  "findings": [
    {
      "id": "driver",
      "for_each": "computed.driver",
      "as": "ds",
      "sev": "critical",
      "title": "GPU Operator driver 容器逃逸面：{{ds.name}}",
      "detail": "privileged={{ds.privileged}} hostPath={{str(ds.hostPath)}} image={{ds.image}}；driver 容器以节点 root 运行，替换镜像/注入命令即节点接管。",
      "evidence": "daemonset={{ds.name}} sa={{ds.serviceAccount}}",
      "mapping": "提权矩阵 platform-gpu-operator-driver；NVIDIA GPU Operator",
      "fix": "driver 容器按最小 hostPath/能力收敛；镜像签名+准入校验；daemonset 写权限仅平台管理员"
    }
  ],
  "artifacts": [
    {
      "name": "gpu-operator-driver-escape-detection.json",
      "kind": "json",
      "fields": {
        "driver": "map(computed.driver, it.name)"
      }
    }
  ]
}
