{
  "schema": "inkblade-probe-template-v1",
  "key": "mps-context-shared",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "MPS context 跨租户共享",
      "en": "MPS Context Shared Across Tenants"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/gpu/mps/status",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "CUDA MPS context/pipe 共享模型与多租户隔离边界（MPS 默认单 server 单用户假设）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "MPS context 跨租户共享（client/pipe 隔离失效）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "CUDA MPS context/pipe 共享模型与多租户隔离边界（MPS 默认单 server 单用户假设）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "mps-context-shared-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
