{
  "schema": "inkblade-probe-template-v1",
  "key": "hypervisor-audit-integrity",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "Hypervisor 侧可信审计完整性检查",
      "en": "Hypervisor-side trusted audit integrity check"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'config-file', 'selector': 'audit/hypervisor-audit.json'}",
      "{'type': 'runtime-agent', 'selector': 'audit-collector'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "审计采集器运行在 guest 内核内",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R01 / I01（USENIX Security 2026 HyperAudit）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "采集器完整性未校验",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R01 / I01（USENIX Security 2026 HyperAudit）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "审计日志可被 guest 写入",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R01 / I01（USENIX Security 2026 HyperAudit）",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "审计日志非 append-only",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R01 / I01（USENIX Security 2026 HyperAudit）",
      "fix": ""
    },
    {
      "id": "f5",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "审计日志未落不可变存储",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R01 / I01（USENIX Security 2026 HyperAudit）",
      "fix": ""
    },
    {
      "id": "f6",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "审计日志远程转发未启用 mTLS",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R01 / I01（USENIX Security 2026 HyperAudit）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "hypervisor-audit-integrity-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
