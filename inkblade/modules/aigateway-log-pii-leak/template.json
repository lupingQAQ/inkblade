{
  "schema": "inkblade-probe-template-v1",
  "key": "aigateway-log-pii-leak",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 网关日志 PII 泄露",
      "en": "AI Gateway Log PII Leak"
    },
    "series": "窃取与数据泄露",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab-only probe"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 24
  },
  "computed": {
    "rows": "count(steps.logs.json.entries)",
    "plaintext_auth": "contains(str(steps.logs.json.entries[*].authorization), 'Bearer MOCK-')",
    "card": "contains(str(steps.logs.json.entries[*].prompt), '4111 1111 1111 1111')",
    "redacted": "steps.logs.json.redacted == true"
  },
  "steps": [
    {
      "id": "logs",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/logs",
      "headers": {
        "Authorization": "Bearer MOCK-tenant-a-key-a1b2",
        "X-Tenant": "tenant-a"
      },
      "save": "logs",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "pii",
      "when": "(computed.plaintext_auth or computed.card) and not computed.redacted",
      "sev": "high",
      "title": "AI 网关日志跨租户泄漏 PII/凭据（明文 authorization + 卡号）",
      "detail": "entries={{computed.rows}} plaintext_auth={{computed.plaintext_auth}} card={{computed.card}} tenant_scoped={{steps.logs.json.tenant_scoped}}",
      "evidence": "{{steps.logs.sha256}}",
      "mapping": "OWASP LLM02/LLM06",
      "fix": "日志字段级脱敏（authorization/card/email）；按租户过滤查询"
    },
    {
      "id": "clean",
      "when": "computed.redacted or not (computed.plaintext_auth or computed.card)",
      "sev": "info",
      "title": "日志已脱敏/按租户过滤",
      "detail": "entries={{computed.rows}} redacted={{computed.redacted}}"
    }
  ],
  "artifacts": [
    {
      "name": "aigateway-log-pii-leak.json",
      "kind": "json",
      "fields": {
        "entries": "computed.rows",
        "redacted": "computed.redacted",
        "plaintext_auth": "computed.plaintext_auth",
        "card": "computed.card"
      }
    }
  ]
}
