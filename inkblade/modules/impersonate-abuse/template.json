{
  "schema": "inkblade-probe-template-v1",
  "key": "impersonate-abuse",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "impersonate 冒充",
      "en": "Impersonation abuse"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  },
  "computed": {
    "roles": "concat(steps.snapshot.json.clusterroles, steps.snapshot.json.roles)",
    "impersonators": "filter(computed.roles, any(it.rules, contains(it.verbs, 'impersonate') and (contains(it.resources, 'users') or contains(it.resources, 'groups') or contains(it.resources, 'serviceaccounts'))))",
    "cani": "contains(lower(str(steps.snapshot.json.cani)), 'impersonate')"
  },
  "findings": [
    {
      "id": "impersonate",
      "for_each": "computed.impersonators",
      "as": "role",
      "sev": "critical",
      "title": "impersonate 动词：{{role.name}}",
      "detail": "可冒充 User/Group/ServiceAccount；若目标绑定 cluster-admin 或 system:masters，则等价直接接管。rules={{str(role.rules)}}",
      "evidence": "role={{role.name}}",
      "mapping": "提权矩阵 rbac-impersonate；MITRE T1078",
      "fix": "禁止 impersonate 进入工作负载 SA；对 impersonatedUser 审计做实时告警"
    },
    {
      "id": "cani",
      "when": "computed.cani and len(computed.impersonators) == 0",
      "sev": "high",
      "title": "can-i 矩阵显示 impersonate 权限",
      "detail": "can-i 输出含 impersonate；需核对目标 users/groups 与是否存在 system:masters 绑定。",
      "evidence": "cani 含 impersonate",
      "fix": "按 resourceNames 收敛；禁止 groups=system:masters 的 impersonate"
    }
  ],
  "artifacts": [
    {
      "name": "impersonate-abuse-detection.json",
      "kind": "json",
      "fields": {
        "impersonators": "map(computed.impersonators, it.name)",
        "cani": "computed.cani"
      }
    }
  ]
}
