      "mapping": "设计基线三轮审计 sink 模式（核心代码检测首批规则）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "true",
      "sev": "high",
      "title": "危险调用 {h[",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线三轮审计 sink 模式（核心代码检测首批规则）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "python-dangerous-sinks-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
