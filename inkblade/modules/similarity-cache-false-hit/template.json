{
  "schema": "inkblade-probe-template-v1",
  "key": "similarity-cache-false-hit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "近似缓存误命中泄露",
      "en": "Similarity cache false-hit leak"
    },
    "series": "窃取与数据泄露",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "benign cache-lab markers only"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "computed": {
    "hit": "steps.attack.status == 200 and steps.attack.json.hit == true",
    "cross_tenant": "steps.attack.json.matched.tenant == 'tenant-b'",
    "victim_response": "contains(str(steps.attack.json.matched.response), 'INKBLADE-BENIGN-APPROX-VICTIM')",
    "similarity": "steps.attack.json.best_similarity"
  },
  "steps": [
    {
      "id": "attack",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/approx/lookup",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "text": "tenant-b quarterly revenue guidance for fiscal 2026 total pipeline equals 42.7M USD with eighteen percent growth revised 2026 estimate"
      },
      "save": "attack",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "false-hit",
      "when": "computed.hit and computed.cross_tenant",
      "sev": "high",
      "title": "近似缓存跨租户假命中：返回 tenant-b 机密响应",
      "detail": "similarity={{computed.similarity}} threshold={{steps.attack.json.threshold}} requester={{steps.attack.json.requester_tenant}} matched_tenant={{steps.attack.json.matched.tenant}} victim_marker={{computed.victim_response}}",
      "evidence": "{{steps.attack.sha256}}",
      "mapping": "similarity-cache-false-hit",
      "fix": "近似缓存按租户分区；相似度检索先做租户过滤"
    },
    {
      "id": "clean",
      "when": "not (computed.hit and computed.cross_tenant)",
      "sev": "info",
      "title": "近似缓存按租户隔离（未跨租户命中）",
      "detail": "status={{steps.attack.status}} hit={{computed.hit}} scope={{steps.attack.json.scope}}"
    }
  ],
  "artifacts": [
    {
      "name": "similarity-cache-false-hit.json",
      "kind": "json",
      "fields": {
        "route": "'/approx/lookup'",
        "hit": "computed.hit",
        "cross_tenant": "computed.cross_tenant",
        "similarity": "computed.similarity",
        "matched": "steps.attack.json.matched"
      }
    }
  ]
}
