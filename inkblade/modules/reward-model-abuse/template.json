{
  "schema": "inkblade-probe-template-v1",
  "key": "reward-model-abuse",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "奖励模型打分面滥用",
      "en": "Reward Model Scoring Abuse"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.surface.ok == true",
      "sev": "medium",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/design.md 第 1–5 节：serve_rm 无鉴权打分面",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.surface.ok == true",
      "sev": "medium",
      "title": "奖励打分面滥用：连续未鉴权打分调用（serve_rm 同构，伪造训练信号）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/design.md 第 1–5 节：serve_rm 无鉴权打分面",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "reward-model-abuse-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
