{
  "schema": "inkblade-probe-template-v1",
  "key": "spank-plugin-integrity",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "SPANK 插件加载完整性审计",
      "en": "SPANK plugin loading integrity audit"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'config-file', 'selector': 'slurm/plugstack.conf'}",
      "{'type': 'runtime-agent', 'selector': 'runtime-agent/spank'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "plugstack.conf 全局可写",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD SPANK / plugstack.conf(5)；docs/SLURM-HPC-COVERAGE.md SPANK 面",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "info",
      "title": "未发现 SPANK 插件（无插件面或导出不完整）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD SPANK / plugstack.conf(5)；docs/SLURM-HPC-COVERAGE.md SPANK 面",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "SPANK 插件加载路径不可信：{path}",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD SPANK / plugstack.conf(5)；docs/SLURM-HPC-COVERAGE.md SPANK 面",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "plugstack.conf 使用 optional 插件（失败静默降级）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD SPANK / plugstack.conf(5)；docs/SLURM-HPC-COVERAGE.md SPANK 面",
      "fix": ""
    },
    {
      "id": "f5",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "插件配置出现 LD_PRELOAD 注入",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "SchedMD SPANK / plugstack.conf(5)；docs/SLURM-HPC-COVERAGE.md SPANK 面",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "spank-plugin-integrity-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
