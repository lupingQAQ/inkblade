{
  "schema": "inkblade-probe-template-v1",
  "key": "gpu-metrics-tenant-leak",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "DCGM 指标跨租户泄露",
      "en": "DCGM Metrics Cross-Tenant Leak"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/gpu/metrics",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "DCGM exporter 租户标签与进程级指标暴露面；GPU 可观测性与多租户隔离",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "DCGM 指标泄露他租户进程名与租户标签",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "DCGM exporter 租户标签与进程级指标暴露面；GPU 可观测性与多租户隔离",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "gpu-metrics-tenant-leak-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
