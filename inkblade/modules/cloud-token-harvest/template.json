{
  "schema": "inkblade-probe-template-v1",
  "key": "cloud-token-harvest",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "云 Token 收割面",
      "en": "Cloud token harvest surface"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "IMDS 可达（实例角色凭据）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates 云凭据收割（CM-21）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "环境变量含 AWS 配置 {aws_env[:4]}",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates 云凭据收割（CM-21）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "GCE 元数据可达（服务账号 token）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates 云凭据收割（CM-21）",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "环境变量指向 GCP 凭据 {gcp_env[:4]}",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates 云凭据收割（CM-21）",
      "fix": ""
    },
    {
      "id": "f5",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "Azure IMDS/MSI 可达",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates 云凭据收割（CM-21）",
      "fix": ""
    },
    {
      "id": "f6",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "环境变量含 Azure 身份线索 {azure_env[:4]}",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates 云凭据收割（CM-21）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "cloud-token-harvest-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
