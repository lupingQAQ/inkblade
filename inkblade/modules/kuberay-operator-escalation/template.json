{
  "schema": "inkblade-probe-template-v1",
  "key": "kuberay-operator-escalation",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "KubeRay Operator 提权",
      "en": "KubeRay Operator Escalation"
