      "mapping": "设计基线第 11 节：KubeRay Operator 准 cluster-admin 权限（Ray 自定义资源全 CRUD + Pod 创建）",
      "fix": "",
      "cves": [
        "KUBERAY-ADV-2026-01"
      ],
      "version_matrix": {
