        "source": "steps.snapshot.json.version",
        "vulnerable": [
          "<*"
        ],
        "note": "version matrix declared by module metadata; refine during migration"
      }
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "ClusterRole「{name}」为准 cluster-admin（{name} → 特权 Pod）",
