{
  "schema": "inkblade-probe-template-v1",
  "key": "api-server-flood-surface",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "apiserver/IMDS 请求洪（配额缺失）",
      "en": "Control-plane request flood via missing quota"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.surface.ok == true",
      "sev": "high",
      "title": "控制面/元数据请求洪无配额（Δ请求 ≥ {FLOOD_THRESHOLD}）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/FABRIC-ATTACK-SURFACE.md §2.6；语料 meta-prometheus（百 k GPU 的控制面依赖）/ kubernetes-cni-spec",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.surface.ok == true",
      "sev": "info",
      "title": "请求配额生效或计数未达阈值（洪泛未成立）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/FABRIC-ATTACK-SURFACE.md §2.6；语料 meta-prometheus（百 k GPU 的控制面依赖）/ kubernetes-cni-spec",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "api-server-flood-surface-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
