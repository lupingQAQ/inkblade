{
  "schema": "inkblade-probe-template-v1",
  "key": "inference-tenant-isolation-baseline",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "多租户推理统一隔离基线",
      "en": "Multi-tenant inference unified isolation baseline"
    },
    "series": "情报",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'http-endpoint', 'selector': '/v1/models'}",
      "{'type': 'http-endpoint', 'selector': '/v1/chat/completions'}",
      "{'type': 'config-file', 'selector': 'inference/tenant-policy.json'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
