{
  "schema": "inkblade-probe-template-v1",
  "key": "etcd-direct-access",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "etcd 直连访问",
      "en": "Direct etcd access"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  },
  "computed": {
    "risky": "filter(steps.snapshot.json.etcd, it.tls != true or it.clientCertAuth != true)"
  },
  "findings": [
    {
      "id": "etcd",
      "for_each": "computed.risky",
      "as": "etcd",
      "sev": "critical",
      "title": "etcd 直连风险：{{etcd.name}}",
      "detail": "endpoint={{etcd.endpoint}} tls={{etcd.tls}} clientCertAuth={{etcd.clientCertAuth}}；可读取全部 Secret/SA token 或写入 RBAC 对象。",
      "evidence": "etcd={{etcd.name}} endpoint={{etcd.endpoint}}",
      "mapping": "提权矩阵 node-etcd-direct；K8s etcd 运维",
      "fix": "启用 etcd mTLS 与客户端证书；2379/2380 仅控制面网段可达"
    }
  ],
  "artifacts": [
    {
      "name": "etcd-direct-access-detection.json",
      "kind": "json",
      "fields": {
        "risky": "map(computed.risky, it.name)"
      }
    }
  ]
}
