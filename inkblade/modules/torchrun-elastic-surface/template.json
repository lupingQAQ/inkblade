{
  "schema": "inkblade-probe-template-v1",
  "key": "torchrun-elastic-surface",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "torchrun 弹性 rendezvous 面",
      "en": "torchrun elastic rendezvous surface"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/train/elastic",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "torchrun 弹性 rendezvous 无鉴权：etcd 明文 + 动态成员可注入伪 rank",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/PRETRAIN-SFT-RL-COVERAGE.md 第 1 节：弹性训练成员面；torchrun --rdzv-backend etcd 语义",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "弹性 rendezvous 被拒绝或已加固（401 / auth / mTLS / 固定成员）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/PRETRAIN-SFT-RL-COVERAGE.md 第 1 节：弹性训练成员面；torchrun --rdzv-backend etcd 语义",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "torchrun-elastic-surface-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
