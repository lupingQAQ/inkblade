{
  "schema": "inkblade-probe-template-v1",
  "key": "reverse-rbac-lookup",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "RBAC 身份反查",
      "en": "Reverse RBAC lookup"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "读取 Secret（token/权重桶/仓库凭据）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates kubectl-can-i（CM-36）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "枚举全部 Secret",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates kubectl-can-i（CM-36）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "在任意 Pod 内执行命令",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates kubectl-can-i（CM-36）",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "创建 Pod（可挂载任意 SA/特权模板）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates kubectl-can-i（CM-36）",
      "fix": ""
    },
    {
      "id": "f5",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "创建 RoleBinding（权限提升）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates kubectl-can-i（CM-36）",
      "fix": ""
    },
    {
      "id": "f6",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "创建 ClusterRoleBinding（集群提权）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "Peirates kubectl-can-i（CM-36）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "reverse-rbac-lookup-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
