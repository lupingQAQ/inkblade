{
  "schema": "inkblade-probe-template-v1",
  "key": "shared-volume-weight-copy",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "共享卷权重直读",
      "en": "Shared Volume Weight Copy"
    },
    "series": "窃取与数据泄露",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {},
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "host",
      "op": "fs",
      "action": "stat",
      "path": "/",
      "save": "host",
      "allow_failure": true
    }
  ],
  "checks": [
    {
      "id": "host-readable",
      "when": "steps.host.exists == true",
      "message": "probe filesystem is not readable"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "true",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 6 节：RWX 共享卷上权重未授权读（哈希存证 + 偷换风险）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "true",
      "sev": "high",
      "title": "共享卷权重可直接读取：{len(weights)} 个权重文件（{total} 字节）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 6 节：RWX 共享卷上权重未授权读（哈希存证 + 偷换风险）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "true",
      "sev": "medium",
      "title": "共享卷数据集可读：{len(datasets)} 个数据文件",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线第 6 节：RWX 共享卷上权重未授权读（哈希存证 + 偷换风险）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "shared-volume-weight-copy-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
