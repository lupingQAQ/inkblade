{
  "schema": "inkblade-probe-template-v1",
  "key": "aigateway-guardrail-bypass",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 网关 guardrail 绕过（角色分层 / 多消息）",
      "en": "AI Gateway Guardrail Bypass (role layering / multi-message)"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "guardrail 绕过：{len(bypassed)} 个变体越过多消息检查（canary={canary_present}）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/AI-GATEWAY.md 第 9 节：guardrail 检查面与角色分层",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "aigateway-guardrail-bypass-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
