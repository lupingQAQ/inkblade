{
  "schema": "inkblade-probe-template-v1",
  "key": "kv-oom-bomb",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "KV/激活 OOM 炸弹（超长上下文无 max 生效）",
      "en": "KV/activation OOM bomb via unenforced context max"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/train/context",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "超长上下文无 max 生效（单请求 KV/激活 OOM 炸弹）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/FABRIC-ATTACK-SURFACE.md §2.7；docs/LONG-CONTEXT.md §2.5（内存放大）；语料 google-tpu-ironwood-ocs（192GB HBM KV 压力）/ deepseek-prefill-decode",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "上下文上限生效或 OOM 未触发（炸弹未成立）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/FABRIC-ATTACK-SURFACE.md §2.7；docs/LONG-CONTEXT.md §2.5（内存放大）；语料 google-tpu-ironwood-ocs（192GB HBM KV 压力）/ deepseek-prefill-decode",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "kv-oom-bomb-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
