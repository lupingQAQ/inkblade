{
  "schema": "inkblade-probe-template-v1",
  "key": "cloud-sg-imds-exposure",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "云安全组放开 IMDS（IMDSv1/hop limit）",
      "en": "Cloud Security Group IMDS Exposure"
    },
    "series": "混合云",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/cloud/security-group",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "AWS IMDSv2 Hop Limit / SG for Pods、Azure NSG、阿里安全组、腾讯安全组与 IMDS 等价控制",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "云安全组放开 IMDS：公网入站 + IMDSv1/hop limit 允许 Pod 直取节点角色",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "AWS IMDSv2 Hop Limit / SG for Pods、Azure NSG、阿里安全组、腾讯安全组与 IMDS 等价控制",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "cloud-sg-imds-exposure-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
