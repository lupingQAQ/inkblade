{
  "schema": "inkblade-probe-template-v1",
  "key": "collective-communication-surface",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "集合通信面测绘",
      "en": "Collective Communication Surface Mapping"
    },
    "series": "网络架构",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "集合通信 bootstrap 无认证（rank 可入组）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "spec 5.2 网络架构模块 + 5.6 集合通信层；组合签名 areal-sglang-nccl-rdma-flatnet / pd-split-nixl-rdma-kv-channel",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "KV/共享内存传输通道明文过网（NIXL/Mooncake/NVSHMEM/DeepEP）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "spec 5.2 网络架构模块 + 5.6 集合通信层；组合签名 areal-sglang-nccl-rdma-flatnet / pd-split-nixl-rdma-kv-channel",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "info",
      "title": "未发现集合通信端点",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "spec 5.2 网络架构模块 + 5.6 集合通信层；组合签名 areal-sglang-nccl-rdma-flatnet / pd-split-nixl-rdma-kv-channel",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "collective-communication-surface-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
