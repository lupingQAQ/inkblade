{
  "schema": "inkblade-probe-template-v1",
  "key": "ray-dashboard-job",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "Ray 控制面作业提交",
      "en": "Ray Dashboard Job Submission"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.surface.ok == true",
      "sev": "high",
      "title": "title",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/design.md 第 1–5 节：Ray dashboard 8265 无鉴权作业提交",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.surface.ok == true",
      "sev": "high",
      "title": "Ray dashboard 无令牌作业提交：头节点任意命令执行",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/design.md 第 1–5 节：Ray dashboard 8265 无鉴权作业提交",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "ray-dashboard-job-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "write-surface demo; requires backup receipt"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  }
}
