{
  "schema": "inkblade-probe-template-v1",
  "key": "rbac-escalate-verb",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "RBAC escalate 提权",
      "en": "Escalate role rewrite"
    },
    "series": "权限链",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
    "surfaces": [
      "k8s-object:ClusterRole"
    ],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true,
      "description": "RBAC snapshot (clusterroles/roles/cani)"
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "computed": {
    "roles": "concat(steps.snapshot.json.clusterroles, steps.snapshot.json.roles)",
    "escalators": "filter(computed.roles, any(it.rules, contains(it.verbs, 'escalate') and (contains(it.resources, 'roles') or contains(it.resources, 'clusterroles'))))",
    "cani_escalate": "contains(lower(str(steps.snapshot.json.cani)), 'escalate')"
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    },
    {
      "id": "demo",
      "op": "fs",
      "action": "write",
      "write": true,
      "when": "params.mode == 'backup-write'",
      "path": "{{params.demo_target}}",
      "content": "# INKBLADE demo {{ctx.marker}} escalate\napiVersion: rbac.authorization.k8s.io/v1\nkind: ClusterRole\nmetadata: {name: inkblade-escalated-demo}\nrules: [{apiGroups: ['*'], resources: ['*'], verbs: ['*']}]\n",
      "save": "demo"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "RBAC snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "escalate-rule",
      "for_each": "computed.escalators",
      "as": "role",
      "when": "true",
      "sev": "critical",
      "title": "escalate 动词：{{role.name}}",
      "detail": "持有 escalate 可将已绑定的角色改写为 *（无需重新绑定），等价获得该角色作用域的全权限。rules={{str(role.rules)}}",
      "evidence": "role={{role.name}} verbs={{map(it.rules, it.verbs)}}",
      "mapping": "提权矩阵 rbac-escalate-verb；KubeHound ESCALATE_ROLE 边",
      "fix": "禁止 escalate 进入日常角色；仅 break-glass 角色保留并强制审批/会话录制"
    },
    {
      "id": "cani-escalate",
      "when": "computed.cani_escalate and len(computed.escalators) == 0",
      "sev": "high",
      "title": "can-i 矩阵显示 escalate 权限（复核绑定主体）",
      "detail": "can-i 输出含 escalate：需确认绑定主体与目标角色范围，避免 operator 默认角色扩散。",
      "evidence": "cani 含 escalate",
      "fix": "用 SubjectAccessReview 逐主体复核；收敛到 resourceNames 精确角色"
    },
    {
      "id": "demo-written",
      "when": "params.mode == 'backup-write'",
      "sev": "high",
      "title": "escalate 改写演示已落盘（可回滚）",
      "detail": "演示 ClusterRole 清单写入 {{params.demo_target}}；真实集群中由已绑定角色 escalate 后生效。",
      "evidence": "demo_target={{params.demo_target}}",
      "mapping": "rbac-escalate-verb demo"
    }
  ],
  "artifacts": [
    {
      "name": "rbac-escalate-verb-detection.json",
      "kind": "json",
      "fields": {
        "module": "'rbac-escalate-verb'",
        "fixture": "input.fixture",
        "escalators": "map(computed.escalators, it.name)",
        "cani_escalate": "computed.cani_escalate",
        "mode": "params.mode"
      }
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "read-only snapshot analysis"
    }
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  }
}
