{
  "schema": "inkblade-probe-template-v1",
  "key": "cache-salt-policy-audit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "缓存 salt 隔离策略审计",
      "en": "Cache salt isolation policy audit"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "benign cache-lab markers only"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "computed": {
    "weak_config": "steps.config.status == 200 and steps.config.json.cache_salt_policy.enabled == false",
    "cross_hit": "steps.reuse.status == 200 and steps.reuse.json.usage.cached_tokens > 0"
  },
  "steps": [
    {
      "id": "config",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/config",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "config",
      "allow_failure": true
    },
    {
      "id": "prime",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {
        "X-Tenant": "tenant-b"
      },
      "body": {
        "prompt_prefix": "tenant-b quarterly revenue guidance for fiscal 2026 total pipeline equals 42.7M USD with eighteen percent growth",
        "prefix_tokens": 2048,
        "max_tokens": 1
      },
      "save": "prime",
      "allow_failure": true
    },
    {
      "id": "reuse",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "prompt_prefix": "tenant-b quarterly revenue guidance for fiscal 2026 total pipeline equals 42.7M USD with eighteen percent growth",
        "prefix_tokens": 2048,
        "max_tokens": 1
      },
      "save": "reuse",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "weak",
      "when": "computed.weak_config and computed.cross_hit",
      "sev": "high",
      "title": "cache_salt 缺失且跨租户前缀命中：缓存键全局共享",
      "detail": "cache_salt_policy={{str(steps.config.json.cache_salt_policy)}} cached_tokens={{steps.reuse.json.usage.cached_tokens}} reuse_status={{steps.reuse.status}}",
      "evidence": "{{steps.config.sha256}}",
      "mapping": "cache-salt-policy-audit",
      "fix": "启用 per-tenant cache_salt，缓存键包含 tenant|salt"
    },
    {
      "id": "partial",
      "when": "not (computed.weak_config and computed.cross_hit) and (computed.cross_hit or computed.weak_config)",
      "sev": "medium",
      "title": "缓存租户隔离存在部分缺口（弱配置或跨租户命中之一）",
      "detail": "weak_config={{computed.weak_config}} cross_hit={{computed.cross_hit}}"
    },
    {
      "id": "clean",
      "when": "not computed.cross_hit and not computed.weak_config",
      "sev": "info",
      "title": "cache_salt 策略完整且未观察到跨租户命中",
      "detail": "config_status={{steps.config.status}} reuse_status={{steps.reuse.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "cache-salt-policy-audit.json",
      "kind": "json",
      "fields": {
        "route": "'/config + /v1/chat/completions'",
        "weak_config": "computed.weak_config",
        "cross_hit": "computed.cross_hit",
        "cached_tokens": "steps.reuse.json.usage.cached_tokens",
        "salt_policy": "steps.config.json.cache_salt_policy"
      }
    }
  ]
}
