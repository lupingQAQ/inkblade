{
  "schema": "inkblade-probe-template-v1",
  "key": "cache-salt-policy-audit",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "缓存 salt 隔离策略审计",
      "en": "Cache salt isolation policy audit"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/config",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe2",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {},
      "save": "probe2",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "缓存隔离策略缺失：cache_salt 未启用（配置面+差分双确认，跨租户 prefix 命中）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/CACHE-SECURITY.md 第 2 节：策略面（vLLM cache_salt/键 scope）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "medium",
      "title": "缓存策略配置面薄弱（cache_salt 关闭/全局键），行为差分未复现",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/CACHE-SECURITY.md 第 2 节：策略面（vLLM cache_salt/键 scope）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "缓存隔离策略已加固（配置面不可读或已启用逐租户 salt，跨租户未命中）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/CACHE-SECURITY.md 第 2 节：策略面（vLLM cache_salt/键 scope）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "cache-salt-policy-audit-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
