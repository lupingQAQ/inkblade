{
  "schema": "inkblade-probe-template-v1",
  "key": "nccl-port-exhaustion",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "NCCL bootstrap 端口耗尽（rendezvous 拒绝服务）",
      "en": "NCCL bootstrap port exhaustion at rendezvous"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/nccl/bootstrap",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "bootstrap 端口池可被单作业占满（后续训练作业 rendezvous 被拒）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/FABRIC-ATTACK-SURFACE.md §2.4；语料 nccl-transports / bytedance-megascale（集合通信初始化 O(n²)→<30s）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "端口耗尽未成立（上限/鉴权拦截）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/FABRIC-ATTACK-SURFACE.md §2.4；语料 nccl-transports / bytedance-megascale（集合通信初始化 O(n²)→<30s）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "nccl-port-exhaustion-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
