{
  "schema": "inkblade-probe-template-v1",
  "key": "attack-path-ranking",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "攻击路径排序",
      "en": "Attack path ranking"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "瓶颈节点：{nid} 被 {hits} 条攻击路径复用",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "KubeHound 最短路径/关键节点（CM-23）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "attack-path-ranking-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
