{
  "schema": "inkblade-probe-template-v1",
  "key": "vllm-pickle-pipe-rce",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "vLLM Mooncake pickle RCE",
      "en": "vLLM Mooncake pickle RCE"
    },
    "series": "核心代码",
    "min_level": "全影响演示",
    "writes": true,
    "requires": [],
    "surfaces": [],
    "cves": [
      "CVE-2025-32444",
      "CVE-2025-29783",
      "CVE-2025-47277"
    ],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    },
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    },
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "observed",
      "when": "steps.surface.ok == true",
      "sev": "info",
      "title": "vLLM Mooncake pickle RCE：部署面已观测",
      "detail": "Template executed and the declared surface responded; no exploitable condition asserted.",
      "evidence": "steps"
    }
  ],
  "artifacts": [
    {
      "name": "vllm-pickle-pipe-rce-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "write-surface demo; requires backup receipt"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  }
}
