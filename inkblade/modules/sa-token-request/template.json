{
  "schema": "inkblade-probe-template-v1",
  "key": "sa-token-request",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "SA TokenRequest 越权",
      "en": "SA token request abuse"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  },
  "computed": {
    "roles": "concat(steps.snapshot.json.clusterroles, steps.snapshot.json.roles)",
    "requesters": "filter(computed.roles, any(it.rules, contains(it.verbs, 'create') and contains(it.resources, 'serviceaccounts/token')))",
    "projected": "filter(steps.snapshot.json.pods, it.volumes != null)",
    "cani": "contains(lower(str(steps.snapshot.json.cani)), 'serviceaccounts/token')"
  },
  "findings": [
    {
      "id": "token",
      "for_each": "computed.requesters",
      "as": "role",
      "sev": "high",
      "title": "TokenRequest 权限：{{role.name}}",
      "detail": "可为高权 SA 申请短期 token；无需读取 Secret，即可借用其身份。rules={{str(role.rules)}}",
      "evidence": "role={{role.name}}",
      "mapping": "提权矩阵 rbac-sa-token-request；TokenRequest API",
      "fix": "限制 resourceNames；对 serviceaccounts/token 创建做主体白名单告警"
    },
    {
      "id": "cani",
      "when": "computed.cani and len(computed.requesters) == 0",
      "sev": "high",
      "title": "can-i 矩阵显示 create serviceaccounts/token",
      "detail": "TokenRequest 子资源可被直接调用；优先核对目标 SA 的角色绑定。",
      "evidence": "cani 含 serviceaccounts/token",
      "fix": "移除跨命名空间 token 创建；改用工作负载自身 SA"
    }
  ],
  "artifacts": [
    {
      "name": "sa-token-request-detection.json",
      "kind": "json",
      "fields": {
        "requesters": "map(computed.requesters, it.name)",
        "cani": "computed.cani"
      }
    }
  ]
}
