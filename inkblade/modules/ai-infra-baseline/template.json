{
  "schema": "inkblade-probe-template-v1",
  "key": "ai-infra-baseline",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "AI 基础设施统一基线（Ray/Notebook/推理）",
      "en": "Unified AI infrastructure baseline (Ray/Notebook/inference)"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'http-endpoint', 'selector': '/v1/models'}",
      "{'type': 'config-file', 'selector': 'ai-infra/inventory.json'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "high",
      "title": "推理/训练进程允许任意出网",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R05 / I55（RSA 2026）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "critical",
      "title": "AI 服务可触达云元数据/IMDS",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R05 / I55（RSA 2026）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "AI 基础设施可访问互联网但无服务清单",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "docs/CONFERENCE-2026-GAPS.md R05 / I55（RSA 2026）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "ai-infra-baseline-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
