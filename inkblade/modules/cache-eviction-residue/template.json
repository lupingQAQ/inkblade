{
  "schema": "inkblade-probe-template-v1",
  "key": "cache-eviction-residue",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "缓存逐出残留读",
      "en": "Cache eviction residue read"
    },
    "series": "窃取与数据泄露",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true,
      "description": "Target base URL"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "surface",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/healthz",
      "save": "surface",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe1",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/cache/residue",
      "headers": {},
      "save": "probe1",
      "allow_failure": true,
      "timeout_ms": 8000
    },
    {
      "id": "probe2",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/router/metrics",
      "headers": {},
      "save": "probe2",
      "allow_failure": true,
      "timeout_ms": 8000
    }
  ],
  "checks": [
    {
      "id": "surface-reachable",
      "when": "steps.surface.status != null",
      "message": "target did not answer the surface probe"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "high",
      "title": "LRU 逐出后残留跨租户可读：{tenant} 读到 {residue_tenant} 被逐出前缀",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/CACHE-SECURITY.md 第 5 节：远程池逐出与残留（分层 KV 生命周期）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "逐出已发生但残留层已 zeroize/不可读（跨租户残留未成立）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/CACHE-SECURITY.md 第 5 节：远程池逐出与残留（分层 KV 生命周期）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.probe1.status == 200 or steps.probe1.status == 201",
      "sev": "info",
      "title": "洪泛未触发逐出（容量过大或计数不可读），残留面未验证",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.probe1.status}}",
      "mapping": "docs/CACHE-SECURITY.md 第 5 节：远程池逐出与残留（分层 KV 生命周期）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "cache-eviction-residue-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
