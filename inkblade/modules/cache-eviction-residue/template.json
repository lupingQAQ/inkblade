{
  "schema": "inkblade-probe-template-v1",
  "key": "cache-eviction-residue",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "缓存逐出残留读",
      "en": "Cache eviction residue read"
    },
    "series": "窃取与数据泄露",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "benign cache-lab markers only"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "computed": {
    "found": "steps.residue.status == 200 and steps.residue.json.found == true",
    "cross_tenant": "steps.residue.json.tenant == 'tenant-b'",
    "marker_present": "contains(steps.residue.json.prefix_preview, 'INKBLADE-BENIGN-RESIDUE-VICTIM')"
  },
  "steps": [
    {
      "id": "flood",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "prompt_prefix": "evict-flood-{{ctx.marker}}-{{i}} unique corpus pressure",
        "prefix_tokens": 2048,
        "max_tokens": 1
      },
      "repeat": 140,
      "save": "flood",
      "allow_failure": true
    },
    {
      "id": "residue",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/cache/residue?prefix=tenant-b%20residue%20corpus%20marker%20INKBLADE-BENIGN-RESIDUE-VICTIM%20quarterly%20close%20data%20pack%20appendix",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "residue",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "residue",
      "when": "computed.found and computed.cross_tenant and computed.marker_present",
      "sev": "high",
      "title": "逐出后前缀残留跨租户可读（tenant-b 语料泄漏）",
      "detail": "route=/cache/residue found=true tenant=tenant-b prefix_preview={{steps.residue.json.prefix_preview}} evicted_at={{steps.residue.json.evicted_at}}",
      "evidence": "{{steps.residue.sha256}}",
      "mapping": "KV 池 LRU 逐出残留；cache-eviction-residue",
      "fix": "逐出即 zeroize；残留层按租户隔离并加密"
    },
    {
      "id": "clean",
      "when": "not (computed.found and computed.cross_tenant and computed.marker_present)",
      "sev": "info",
      "title": "未发现跨租户逐出残留（zeroize 或租户隔离生效）",
      "detail": "status={{steps.residue.status}} error={{steps.residue.error}}"
    }
  ],
  "artifacts": [
    {
      "name": "cache-eviction-residue.json",
      "kind": "json",
      "fields": {
        "route": "'/cache/residue'",
        "found": "computed.found",
        "cross_tenant": "computed.cross_tenant",
        "marker_present": "computed.marker_present",
        "tenant": "steps.residue.json.tenant",
        "preview": "steps.residue.json.prefix_preview"
      }
    }
  ]
}
