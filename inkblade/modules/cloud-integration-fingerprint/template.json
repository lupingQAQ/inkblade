{
  "schema": "inkblade-probe-template-v1",
  "key": "cloud-integration-fingerprint",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "云集成指纹",
      "en": "Cloud integration fingerprint"
    },
    "series": "侦察",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
    {
      "id": "f1",
      "when": "steps.snapshot.exists == true",
      "sev": "info",
      "title": "云商识别：{provider}（{len(names)} 节点）",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线 12.1 云商 K8s 架构源；四条云侧权重桶链前置（多云元数据凭据面/云角色过权）",
      "fix": ""
    },
    {
      "id": "f2",
      "when": "steps.snapshot.exists == true",
      "sev": "info",
      "title": "未识别云商（providerID 缺失）→ 自建/裸金属形态判定",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线 12.1 云商 K8s 架构源；四条云侧权重桶链前置（多云元数据凭据面/云角色过权）",
      "fix": ""
    },
    {
      "id": "f3",
      "when": "steps.snapshot.exists == true",
      "sev": "info",
      "title": "云存储类：{sc.get(",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线 12.1 云商 K8s 架构源；四条云侧权重桶链前置（多云元数据凭据面/云角色过权）",
      "fix": ""
    },
    {
      "id": "f4",
      "when": "steps.snapshot.exists == true",
      "sev": "medium",
      "title": "混合互联形态：{ic.get(",
      "detail": "Declarative probe assertion (baseline migrated from the module rule).",
      "evidence": "{{steps.snapshot.path}}",
      "mapping": "设计基线 12.1 云商 K8s 架构源；四条云侧权重桶链前置（多云元数据凭据面/云角色过权）",
      "fix": ""
    }
  ],
  "artifacts": [
    {
      "name": "cloud-integration-fingerprint-probe.json",
      "from": "steps",
      "kind": "json"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN",
      "note": "no exploit payload"
    }
  },
  "limits": {
    "timeout_ms": 60000,
    "max_http_requests": 64
  }
}
