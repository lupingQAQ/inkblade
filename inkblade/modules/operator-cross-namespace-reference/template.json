{
  "schema": "inkblade-probe-template-v1",
  "key": "operator-cross-namespace-reference",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "Kubernetes Operator 跨 namespace 引用图检查",
      "en": "Kubernetes operator cross-namespace reference graph check"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [
      "{'type': 'k8s-object', 'selector': 'CustomResourceDefinition/*'}",
      "{'type': 'k8s-object', 'selector': 'ClusterRole/*'}"
    ],
    "cves": [],
    "fidelity": "reduced"
  },
  "inputs": {
    "snapshot": {
      "from": "params.snapshot",
      "required": true,
      "description": "Collected snapshot / fixture path"
    }
  },
  "defaults": {
    "timeout_ms": 8000,
    "tls_verify": false
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.snapshot}}",
      "json": true,
      "save": "snapshot",
      "allow_failure": false
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "findings": [
