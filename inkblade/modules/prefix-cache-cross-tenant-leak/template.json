{
  "schema": "inkblade-probe-template-v1",
  "key": "prefix-cache-cross-tenant-leak",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "prefix cache 跨租户泄露",
      "en": "Prefix cache cross-tenant leak"
    },
    "series": "窃取与数据泄露",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "computed": {
    "prime_ok": "steps.prime.status == 200",
    "reuse_cached": "steps.reuse.json.usage.cached_tokens",
    "leak": "steps.reuse.status == 200 and steps.reuse.json.usage.cached_tokens > 0"
  },
  "steps": [
    {
      "id": "prime",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {
        "X-Tenant": "tenant-b"
      },
      "body": {
        "model": "longctx-mock",
        "max_tokens": 1,
        "messages": [
          {
            "role": "user",
            "content": "tenant-b confidential prefix INKBLADE-BENIGN cache seed"
          }
        ]
      },
      "save": "prime",
      "allow_failure": true
    },
    {
      "id": "reuse",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/v1/chat/completions",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "model": "longctx-mock",
        "max_tokens": 1,
        "messages": [
          {
            "role": "user",
            "content": "tenant-b confidential prefix INKBLADE-BENIGN cache seed"
          }
        ]
      },
      "save": "reuse",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "leak",
      "when": "computed.leak",
      "sev": "high",
      "title": "长上下文前缀缓存跨租户命中（tenant-a 复用 tenant-b 前缀）",
      "detail": "cached_tokens={{computed.reuse_cached}} context_window={{steps.reuse.json.context_window}} tenant=tenant-a",
      "evidence": "{{steps.reuse.sha256}}",
      "mapping": "OWASP LLM08",
      "fix": "前缀键包含 tenant|salt；跨租户复用返回 403"
    },
    {
      "id": "clean",
      "when": "not computed.leak",
      "sev": "info",
      "title": "前缀缓存按租户隔离",
      "detail": "status={{steps.reuse.status}} cached={{steps.reuse.json.usage.cached_tokens}}"
    }
  ],
  "artifacts": [
    {
      "name": "prefix-cache-cross-tenant-leak.json",
      "kind": "json",
      "fields": {
        "leak": "computed.leak",
        "cached_tokens": "computed.reuse_cached",
        "route": "'/v1/chat/completions'"
      }
    }
  ]
}
