{
  "schema": "inkblade-probe-template-v1",
  "key": "prefill-decode-kv-channel-unauth",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "PD 分离 KV 通道未鉴权",
      "en": "Prefill-decode KV channel unauthenticated"
    },
    "series": "网络架构",
    "min_level": "主动探测",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "target": {
      "from": "params.target",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 16
  },
  "computed": {
    "channel_open": "steps.kv.status == 200 and steps.kv.json.service == 'longctx-infer'",
    "metrics_open": "steps.metrics.status == 200"
  },
  "steps": [
    {
      "id": "metrics",
      "op": "http",
      "method": "GET",
      "url": "{{input.target}}/metrics",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "save": "metrics",
      "allow_failure": true
    },
    {
      "id": "kv",
      "op": "http",
      "method": "POST",
      "url": "{{input.target}}/kv/transfer",
      "headers": {
        "X-Tenant": "tenant-a"
      },
      "body": {
        "op": "read",
        "block_id": "tenant-b/ctx/seed-001"
      },
      "save": "kv",
      "allow_failure": true
    }
  ],
  "findings": [
    {
      "id": "open",
      "when": "computed.channel_open",
      "sev": "high",
      "title": "Prefill/Decode KV 传输通道未鉴权可读",
      "detail": "status={{steps.kv.status}} found={{steps.kv.json.found}} block={{steps.kv.json.block_id}} layer={{steps.kv.json.layer}}",
      "evidence": "{{steps.kv.sha256}}",
      "mapping": "PD KV channel isolation",
      "fix": "KV 通道强制 mTLS/租户鉴权；block 命名空间校验"
    },
    {
      "id": "clean",
      "when": "not computed.channel_open",
      "sev": "info",
      "title": "KV 传输通道鉴权生效",
      "detail": "status={{steps.kv.status}}"
    }
  ],
  "artifacts": [
    {
      "name": "prefill-decode-kv-channel-unauth.json",
      "kind": "json",
      "fields": {
        "channel_open": "computed.channel_open",
        "found": "steps.kv.json.found",
        "block": "steps.kv.json.block_id",
        "kv_cache_usage": "steps.metrics.json.kv_cache_usage"
      }
    }
  ]
}
