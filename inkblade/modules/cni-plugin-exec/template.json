{
  "schema": "inkblade-probe-template-v1",
  "key": "cni-plugin-exec",
  "version": "1.0.0",
  "meta": {
    "name": {
      "zh": "CNI 插件执行面",
      "en": "CNI plugin execution"
    },
    "series": "权限链",
    "min_level": "只读侦察",
    "writes": false,
    "requires": [],
    "surfaces": [],
    "cves": [],
    "fidelity": "equivalent"
  },
  "inputs": {
    "fixture": {
      "from": "coalesce(params.fixture, params.snapshot)",
      "required": true
    }
  },
  "defaults": {
    "timeout_ms": 8000
  },
  "steps": [
    {
      "id": "snapshot",
      "op": "fs",
      "action": "read",
      "path": "{{input.fixture}}",
      "json": true,
      "save": "snapshot"
    }
  ],
  "checks": [
    {
      "id": "snapshot-readable",
      "when": "steps.snapshot.ok == true",
      "fatal": true,
      "message": "snapshot is not readable JSON"
    }
  ],
  "payloads": {
    "benign": {
      "marker": "INKBLADE-BENIGN"
    }
  },
  "limits": {
    "timeout_ms": 30000,
    "max_http_requests": 8
  },
  "computed": {
    "cni": "filter(steps.snapshot.json.daemonsets, (contains(lower(it.name), 'calico') or contains(lower(it.name), 'cilium') or contains(lower(it.name), 'cni') or contains(str(it.hostPath), '/opt/cni/bin')) and (it.privileged == true or contains(str(it.hostPath), '/opt/cni/bin')))"
  },
  "findings": [
    {
      "id": "cni",
      "for_each": "computed.cni",
      "as": "ds",
      "sev": "critical",
      "title": "CNI 插件执行面：{{ds.name}}",
      "detail": "privileged={{ds.privileged}} hostPath={{str(ds.hostPath)}}；CNI 以节点 root 运行，替换二进制/注入 hook 可在所有节点执行。",
      "evidence": "daemonset={{ds.name}} sa={{ds.serviceAccount}}",
      "mapping": "提权矩阵 platform-cni-plugin；CNI 规范",
      "fix": "CNI 镜像签名+只读根；/opt/cni/bin 仅 kubelet 可写；daemonset 变更双人审批"
    }
  ],
  "artifacts": [
    {
      "name": "cni-plugin-exec-detection.json",
      "kind": "json",
      "fields": {
        "cni": "map(computed.cni, it.name)"
      }
    }
  ]
}
