{
 "key": "pii-logs-unauth-full-dump",
 "title": {
  "zh": "网关日志未授权全量拉取（邮箱/电话）",
  "en": "Unauth gateway log full dump (email/phone)"
 },
 "category": "pii-leak",
 "face": "gateway",
 "target_face": "gateway-logs",
 "preconditions": [
  "lab/ai_gateway_sim /logs 可达"
 ],
 "request": [
  {
   "method": "GET",
   "path": "/logs",
   "auth": "none",
   "body": null
  }
 ],
 "detector": {
  "kind": "regex",
  "patterns": [
   "alice@example\\.com",
   "\\+1-555-0134"
  ]
 },
 "severity": "critical",
 "rule_key": "sigma-llm-probe-pii-leak",
 "expect": {
  "vulnerable": "hit",
  "fixed": "miss"
 }
}
