{
 "key": "cp-cross-tenant-lookup",
 "title": {
  "zh": "语义缓存跨租户命中（键无租户域）",
  "en": "Semantic-cache cross-tenant hit (tenant-less key)"
 },
 "category": "cache-poison",
 "face": "gateway",
 "target_face": "gateway-cache",
 "preconditions": [
  "lab/ai_gateway_sim /cache/* 可达"
 ],
 "request": [
  {
   "method": "POST",
   "path": "/cache/store",
   "auth": "victim-tenant",
   "body": {
    "text": "Quarterly revenue guidance for fiscal 2026: 42.7M USD",
    "response": "tenant-b confidential reseed TRIDENT-VICTIM-ENTRY"
   }
  },
  {
   "method": "POST",
   "path": "/cache/lookup",
   "auth": "tenant",
   "body": {
    "text": "Quarterly revenue guidance for fiscal 2026: 42.7M USD"
   }
  }
 ],
 "detector": {
  "kind": "json_path",
  "path": "entry.tenant",
  "equals": "tenant-b"
 },
 "severity": "critical",
 "rule_key": "sigma-llm-probe-cache-poison",
 "expect": {
  "vulnerable": "hit",
  "fixed": "miss"
 }
}
