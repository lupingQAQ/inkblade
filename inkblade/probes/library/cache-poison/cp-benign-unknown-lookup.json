{
 "key": "cp-benign-unknown-lookup",
 "title": {
  "zh": "未知键查询不命中（防误报对照）",
  "en": "Unknown-key lookup misses (false-positive control)"
 },
 "category": "cache-poison",
 "face": "gateway",
 "target_face": "gateway-cache",
 "preconditions": [
  "lab/ai_gateway_sim /cache/* 可达"
 ],
 "request": [
  {
   "method": "POST",
   "path": "/cache/lookup",
   "auth": "tenant",
   "body": {
    "text": "no such cached prompt in either mode"
   }
  }
 ],
 "detector": {
  "kind": "json_path",
  "path": "entry.tenant",
  "equals": "tenant-b"
 },
 "severity": "low",
 "rule_key": "sigma-llm-probe-cache-poison",
 "expect": {
  "vulnerable": "miss",
  "fixed": "miss"
 }
}
