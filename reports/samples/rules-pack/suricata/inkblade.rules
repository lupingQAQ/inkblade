# InkBlade Suricata signatures (monitor mode) - deploy with HOME_NET/ML_NET vars
# vars: ML_NET = ML 分区网段（training/inference/ray-system）；BASTION_NET = 管理网段

# --- suricata-admin-endpoint-uri: ML 管理端点 URI 签名（无鉴权管理面访问特征） (tuning: HOME_NET/ML_NET 变量按分区模板配置；URI 清单按客户自研管理面路由追加；建议对 POST 方法 + 非...) ---
alert http any any -> $ML_NET any (msg:"INKBLADE admin endpoint URI /pull_weights"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/pull_weights"; sid:9000001; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-admin-endpoint-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE admin endpoint URI /set_env"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/set_env"; sid:9000002; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-admin-endpoint-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE admin endpoint URI /create_engine"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/create_engine"; sid:9000003; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-admin-endpoint-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE admin endpoint URI /fetch_weights"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/fetch_weights"; sid:9000004; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-admin-endpoint-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE admin endpoint URI /awex"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/awex"; sid:9000005; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-admin-endpoint-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE admin endpoint URI /update_weights_from_disk"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/update_weights_from_disk"; sid:9000006; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-admin-endpoint-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE admin endpoint URI /pause"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/pause"; sid:9000007; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-admin-endpoint-uri;)

# --- suricata-imds-egress: 云元数据出网探测（IMDS 凭据面） (tuning: 合法调用方（云 provider 组件节点池）按节点 CIDR 白名单；EKS 侧配合 IMDSv2 强制（Hop Li...) ---
alert ip $ML_NET any -> 169.254.169.254 any (msg:"INKBLADE IMDS egress from ML partition"; flow:to_server; sid:9000101; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-imds-egress;)
alert http $ML_NET any -> any any (msg:"INKBLADE metadata URI /latest/meta-data"; flow:established,to_server; http.uri; content:"/latest/meta-data"; sid:9000102; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-imds-egress;)
alert http $ML_NET any -> any any (msg:"INKBLADE metadata URI /computeMetadata"; flow:established,to_server; http.uri; content:"/computeMetadata"; sid:9000103; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-imds-egress;)
alert http $ML_NET any -> any any (msg:"INKBLADE metadata URI /metadata/instance"; flow:established,to_server; http.uri; content:"/metadata/instance"; sid:9000104; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-imds-egress;)

# --- suricata-nccl-kv-ports: 集合通信 / KV 传输端口异常流量（NCCL TCPStore、NIXL/Mooncake） (tuning: 端口集按训练平台的 rendezvous/KV 传输实际配置扩展（动态端口段按范围写 rule）；RDMA/RoCE 面...) ---
alert tcp any any -> $ML_NET [29400, 29500, 29501, 29511, 45678] (msg:"INKBLADE collective/KV transfer port access from outside partition"; flow:to_server; flags:S; sid:9000201; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-nccl-kv-ports;)

# --- suricata-longctx-kv-endpoints: 长上下文 / PD KV 端点异常访问（prefix cache 复用与 KV 通道写入） (tuning: 按推理分区登记合法调用方（网关/EPP/训练 eval 作业）；/metrics 建议仅允许监控命名空间抓取；KV 传输...) ---
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /v1/chat/completions from outside partition"; flow:established,to_server; http.uri; content:"/v1/chat/completions"; sid:9000301; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-longctx-kv-endpoints;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /kv/transfer from outside partition"; flow:established,to_server; http.uri; content:"/kv/transfer"; sid:9000302; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-longctx-kv-endpoints;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /checkpoint/shards from outside partition"; flow:established,to_server; http.uri; content:"/checkpoint/shards"; sid:9000303; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-longctx-kv-endpoints;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /metrics from outside partition"; flow:established,to_server; http.uri; content:"/metrics"; sid:9000304; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-longctx-kv-endpoints;)

# --- suricata-gpu-cloud-tenant-uri: GPU 池调度/云租户异常调用（无鉴权分配、跨账户 AssumeRole） (tuning: 按管理网段登记合法调度器/云控制面调用方；对来自训练/推理租户网段的 /gpu/allocate 与 /cloud/id...) ---
alert http any any -> $ML_NET any (msg:"INKBLADE GPU pool / cloud tenant endpoint /gpu/allocate"; flow:established,to_server; http.uri; content:"/gpu/allocate"; sid:9000401; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-gpu-cloud-tenant-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE GPU pool / cloud tenant endpoint /gpu/release"; flow:established,to_server; http.uri; content:"/gpu/release"; sid:9000402; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-gpu-cloud-tenant-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE GPU pool / cloud tenant endpoint /cloud/identity"; flow:established,to_server; http.uri; content:"/cloud/identity"; sid:9000403; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-gpu-cloud-tenant-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE GPU pool / cloud tenant endpoint /cloud/bucket/list"; flow:established,to_server; http.uri; content:"/cloud/bucket/list"; sid:9000404; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-gpu-cloud-tenant-uri;)

# --- suricata-ai-gateway-admin-uri: AI 网关管理端点访问（key 签发 / 配置 / 控制台） (tuning: 管理端点为高价值签名：来源非 bastion/运维网段时直接 alert；/config 建议叠加响应体大小与 200 ...) ---
alert http any any -> $ML_NET any (msg:"INKBLADE AI gateway admin URI /key/generate from non-admin source"; flow:established,to_server; http.uri; content:"/key/generate"; sid:9000501; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-ai-gateway-admin-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE AI gateway admin URI /config from non-admin source"; flow:established,to_server; http.uri; content:"/config"; sid:9000502; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-ai-gateway-admin-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE AI gateway admin URI /admin/console from non-admin source"; flow:established,to_server; http.uri; content:"/admin/console"; sid:9000503; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-ai-gateway-admin-uri;)

# --- suricata-fabric-control-uri: fabric 控制面 URI 异常访问（SHARP/IB SM/PFC/NCCL/调度/健康） (tuning: fabric 运维网段（网络 operator/驱动 DaemonSet/调度器）入白名单；POST + 非白名单源直接...) ---
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /sharp/sessions from outside partition"; flow:established,to_server; http.uri; content:"/sharp/sessions"; sid:9000601; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /sharp/reduce from outside partition"; flow:established,to_server; http.uri; content:"/sharp/reduce"; sid:9000602; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /ib/sm/partition from outside partition"; flow:established,to_server; http.uri; content:"/ib/sm/partition"; sid:9000603; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /roce/pfc from outside partition"; flow:established,to_server; http.uri; content:"/roce/pfc"; sid:9000604; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /nccl/bootstrap from outside partition"; flow:established,to_server; http.uri; content:"/nccl/bootstrap"; sid:9000605; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /nccl/rank from outside partition"; flow:established,to_server; http.uri; content:"/nccl/rank"; sid:9000606; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /nccl/rail from outside partition"; flow:established,to_server; http.uri; content:"/nccl/rail"; sid:9000607; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /checkpoint/io from outside partition"; flow:established,to_server; http.uri; content:"/checkpoint/io"; sid:9000608; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /apiserver/request from outside partition"; flow:established,to_server; http.uri; content:"/apiserver/request"; sid:9000609; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /imds/request from outside partition"; flow:established,to_server; http.uri; content:"/imds/request"; sid:9000610; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /sched/gang from outside partition"; flow:established,to_server; http.uri; content:"/sched/gang"; sid:9000611; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /gpu/health from outside partition"; flow:established,to_server; http.uri; content:"/gpu/health"; sid:9000612; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /train/gradient from outside partition"; flow:established,to_server; http.uri; content:"/train/gradient"; sid:9000613; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /train/context from outside partition"; flow:established,to_server; http.uri; content:"/train/context"; sid:9000614; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-fabric-control-uri;)

# --- suricata-cache-plane-uri: 缓存面端点 URI 签名（KV 池/近似缓存/残留/路由指标） (tuning: HOME_NET/ML_NET 变量按分区模板配置；缓存面端点仅应从引擎与 bastion 访问，其余来源先计数后告警；...) ---
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /kvpool/blocks from outside partition"; flow:established,to_server; http.uri; content:"/kvpool/blocks"; sid:9000701; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-cache-plane-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /approx/lookup from outside partition"; flow:established,to_server; http.uri; content:"/approx/lookup"; sid:9000702; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-cache-plane-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /cache/residue from outside partition"; flow:established,to_server; http.uri; content:"/cache/residue"; sid:9000703; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-cache-plane-uri;)
alert http any any -> $ML_NET any (msg:"INKBLADE long-context/KV endpoint /router/metrics from outside partition"; flow:established,to_server; http.uri; content:"/router/metrics"; sid:9000704; rev:1; metadata:inkblade.mode=monitor, inkblade.rule=suricata-cache-plane-uri;)
