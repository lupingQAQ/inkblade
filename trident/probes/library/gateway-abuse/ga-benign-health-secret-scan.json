{
 "key": "ga-benign-health-secret-scan",
 "title": {
  "zh": "/health 良性探测（上游密钥防误报对照）",
  "en": "Benign /health probe (upstream-key false-positive control)"
 },
 "category": "gateway-abuse",
 "face": "gateway",
 "target_face": "gateway-admin",
 "preconditions": [
  "lab/ai_gateway_sim /health 可达"
 ],
 "request": [
  {
   "method": "GET",
   "path": "/health",
   "auth": "none",
   "body": null
  }
 ],
 "detector": {
  "kind": "regex",
  "patterns": [
   "MOCK-openai-upstream-key"
  ]
 },
 "severity": "low",
 "rule_key": "sigma-llm-probe-gateway-abuse",
 "expect": {
  "vulnerable": "miss",
  "fixed": "miss"
 }
}
