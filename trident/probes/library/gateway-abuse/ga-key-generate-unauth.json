{
 "key": "ga-key-generate-unauth",
 "title": {
  "zh": "未授权签发全权 API key",
  "en": "Unauth issuance of admin API key"
 },
 "category": "gateway-abuse",
 "face": "gateway",
 "target_face": "gateway-admin",
 "preconditions": [
  "lab/ai_gateway_sim /key/generate 可达"
 ],
 "request": [
  {
   "method": "POST",
   "path": "/key/generate",
   "auth": "none",
   "body": {
    "tenant": "tenant-b"
   }
  }
 ],
 "detector": {
  "kind": "json_path",
  "path": "admin",
  "equals": true
 },
 "severity": "critical",
 "rule_key": "sigma-llm-probe-gateway-abuse",
 "expect": {
  "vulnerable": "hit",
  "fixed": "miss"
 }
}
