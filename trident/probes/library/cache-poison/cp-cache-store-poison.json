{
 "key": "cp-cache-store-poison",
 "title": {
  "zh": "缓存存储投毒（覆写受害者条目）",
  "en": "Cache store poisoning (overwrite victim entry)"
 },
 "category": "cache-poison",
 "face": "gateway",
 "target_face": "gateway-cache",
 "preconditions": [
  "lab/ai_gateway_sim /cache/* 可达"
 ],
 "request": [
  {
   "method": "POST",
   "path": "/cache/store",
   "auth": "tenant",
   "body": {
    "text": "Quarterly revenue guidance for fiscal 2026: 42.7M USD",
    "response": "attacker answer TRIDENT-POISON"
   }
  },
  {
   "method": "POST",
   "path": "/cache/lookup",
   "auth": "victim-tenant",
   "body": {
    "text": "Quarterly revenue guidance for fiscal 2026: 42.7M USD"
   }
  }
 ],
 "detector": {
  "kind": "regex",
  "patterns": [
   "TRIDENT-POISON"
  ]
 },
 "severity": "critical",
 "rule_key": "sigma-llm-probe-cache-poison",
 "expect": {
  "vulnerable": "hit",
  "fixed": "miss"
 }
}
