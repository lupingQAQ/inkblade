{
  "schema": "trident-profile-v1",
  "name": "slurm-hpc",
  "description": "Bare-metal Slurm HPC cluster: no Kubernetes API, BMC/IB switch management, Munge/JWT auth, shared model files, vLLM/MLflow services and Slurm REST API.",
  "platform": "slurm",
  "complete": true,
  "components": {
    "orchestrator": "slurm",
    "scheduler": "slurmctld",
    "gpu_sharing": "none",
    "inference": ["vllm"],
    "experiment_tracker": "mlflow",
    "auth": ["munge", "jwt"],
    "storage": ["lustre", "gpfs", "nfs"],
    "hardware": ["bmc", "switch", "gpu", "tpm"],
    "cloud_metadata": "absent"
  },
  "surfaces": [
    {"type": "config-file", "selector": "slurm/slurm.conf"},
    {"type": "config-file", "selector": "slurm/cgroup.conf"},
    {"type": "config-file", "selector": "slurm/slurmdbd.conf"},
    {"type": "config-file", "selector": "slurm/munge.conf"},
    {"type": "config-file", "selector": "slurm/munge.key.meta"},
    {"type": "config-file", "selector": "slurm/plugstack.conf"},
    {"type": "config-file", "selector": "slurm/slurmrestd.env"},
    {"type": "config-file", "selector": "slurm/jwt.json"},
    {"type": "config-file", "selector": "slurm/nodes.json"},
    {"type": "config-file", "selector": "slurm/partitions.json"},
    {"type": "config-file", "selector": "slurm/qos.json"},
    {"type": "config-file", "selector": "slurm/gres.json"},
    {"type": "config-file", "selector": "slurm/prolog-epilog.json"},
    {"type": "config-file", "selector": "storage/lustre/mounts.json"},
    {"type": "config-file", "selector": "storage/gpfs/mounts.json"},
    {"type": "config-file", "selector": "train/config.yaml"},
    {"type": "config-file", "selector": "vllm/config.yaml"},
    {"type": "config-file", "selector": "mlflow/config.yaml"},
    {"type": "config-file", "selector": "ai-infra/inventory.json"},
    {"type": "config-file", "selector": "inference/tenant-policy.json"},
    {"type": "config-file", "selector": "iommu/kernel-cmdline.txt"},
    {"type": "config-file", "selector": "attest/tpm.json"},
    {"type": "config-file", "selector": "spdm/device-export.json"},
    {"type": "config-file", "selector": "firmware/vendor-inventory.json"},
    {"type": "config-file", "selector": "nvswitch/imex.json"},
    {"type": "config-file", "selector": "ib/partitions.conf"},
    {"type": "config-file", "selector": "fabric/ibdiagnet.out"},
    {"type": "http-endpoint", "selector": "/slurm/v0.0.40/jobs"},
    {"type": "http-endpoint", "selector": "/slurm/v0.0.40/nodes"},
    {"type": "http-endpoint", "selector": "/slurm/v0.0.40/partitions"},
    {"type": "http-endpoint", "selector": "/openapi.json"},
    {"type": "http-endpoint", "selector": "/metrics"},
    {"type": "http-endpoint", "selector": "/v1/models"},
    {"type": "http-endpoint", "selector": "/v1/chat/completions"},
    {"type": "http-endpoint", "selector": "/api"},
    {"type": "http-endpoint", "selector": "/dpu"},
    {"type": "bmc", "selector": "bmc/redfish"},
    {"type": "bmc", "selector": "bmc/dpu"},
    {"type": "bmc", "selector": "tpm/tpm2"},
    {"type": "switch", "selector": "switch/ib"},
    {"type": "switch", "selector": "switch/fabric"},
    {"type": "switch", "selector": "switch/sonic"},
    {"type": "runtime-agent", "selector": "runtime-agent/slurmctld"},
    {"type": "runtime-agent", "selector": "runtime-agent/slurmd"},
    {"type": "runtime-agent", "selector": "runtime-agent/slurmdbd"},
    {"type": "runtime-agent", "selector": "runtime-agent/slurmrestd"},
    {"type": "runtime-agent", "selector": "runtime-agent/munge"},
    {"type": "runtime-agent", "selector": "runtime-agent/spank"},
    {"type": "runtime-agent", "selector": "runtime-agent/cgroup"},
    {"type": "runtime-agent", "selector": "runtime-agent/pmix"},
    {"type": "runtime-agent", "selector": "runtime-agent/nccl"},
    {"type": "runtime-agent", "selector": "runtime-agent/dcgm-exporter"},
    {"type": "model-file", "selector": "model/weights/model.safetensors"},
    {"type": "model-file", "selector": "checkpoint/latest/model.safetensors"}
  ]
}
